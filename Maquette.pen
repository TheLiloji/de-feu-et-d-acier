                    {
                      "type": "text",
                      "id": "n0173",
                      "name": "On étudie les arts martiaux ",
                      "fill": "$parch-soft",
                      "textGrowth": "fixed-width",
                      "width": 660,
                      "content": "On étudie les arts martiaux européens à partir des traités et sources historiques, dans une pratique moderne, sportive et sécurisée. On y vient pour le geste, pas pour le costume.",
                      "lineHeight": 1.6,
                      "fontFamily": "$body",
                      "fontSize": 19,
                      "fontWeight": "normal"
                    },
