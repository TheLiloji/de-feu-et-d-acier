                          "name": "ÉQUIPEMENT",
                          "fill": "$ember",
                          "content": "ÉQUIPEMENT",
                          "fontFamily": "$eyebrow",
                          "fontSize": 10.5,
                          "fontWeight": "600",
                          "letterSpacing": 2.9
                        },
                        {
                          "type": "text",
                          "id": "n0424",
                          "name": "Black Armoury",
                          "fill": "$parch",
                          "content": "Black Armoury",
                          "lineHeight": 1.1,
                          "fontFamily": "$display",
                          "fontSize": 34,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "n0425",
                          "name": "Partenaire incontournable de",
                          "fill": "$parch-soft",
                          "textGrowth": "fixed-width",
                          "width": 976,
                          "content": "Partenaire incontournable de la scène AMHE. Black Armoury a développé de nombreux produits aujourd'hui exclusifs a sa marque, la Veste Arcem notament est l'un des produits les mieux désigné pour notre pratique, et largement privilégié au club. Avec sa volonté d'innover sur le matériel et les protections, Black armoury s'impose dans la production d'equipement toujours plus calibré pour nos besoins.",
                          "lineHeight": 1.6,
                          "fontFamily": "$body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "n0426",
                          "name": "esp",
                          "width": 10,
                          "height": 8,
                          "layout": "none"
