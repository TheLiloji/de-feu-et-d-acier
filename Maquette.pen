                          "fill": "$ember",
                          "content": "AFFILIATION",
                          "fontFamily": "$eyebrow",
                          "fontSize": 10.5,
                          "fontWeight": "600",
                          "letterSpacing": 2.9
                        },
                        {
                          "type": "text",
                          "id": "n0404",
                          "name": "FFAMHE",
                          "fill": "$parch",
                          "content": "FFAMHE",
                          "lineHeight": 1.1,
                          "fontFamily": "$display",
                          "fontSize": 34,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "n0405",
                          "name": "La Fédération Française des ",
                          "fill": "$parch-soft",
                          "textGrowth": "fixed-width",
                          "width": 976,
                          "content": "La Fédération Française des Arts Martiaux Historiques Européens est la colonne vertébrale de tout le milieu AMHE en France. Sans elle, pas de circuit de tournois national, pas de lien entre les associations, pas de cadre pour assurer et reconnaître les clubs. Notre affiliation, c'est ce qui permet au club de rejoindre la scène nationale, et à chaque séance ici d'être rattachée à un travail collectif beaucoup plus large que notre seule salle.",
                          "lineHeight": 1.6,
                          "fontFamily": "$body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "n0406",
                          "name": "esp",
                          "width": 10,
                          "height": 8,
                          "layout": "none"
                        },
