---
/**
 * Fiche d'un encadrant — `/profs/<slug>/`, gabarit de design-spec §6.
 *
 * Cinq blocs, dans l'ordre : fil d'Ariane, hero (portrait + identité + vidéo),
 * biographie, interview, bande d'appel. Les blocs vidéo et interview sont
 * masqués tant qu'ils sont vides (ARCHITECTURE.md §1), et la page reste
 * complète sans eux.
 *
 * **La vidéo a deux emplacements, et c'est l'admin qui tranche.** Le bloc du
 * hero a été dessiné pour une interview : une vignette de 640 px, sous
 * l'accroche, dans la colonne de texte. Une vidéo qui n'est pas une interview —
 * un extrait de combat, un highlight de tournoi — n'y est pas à sa place ; elle
 * illustre l'encadrant, elle ne le raconte pas. La case « Vidéo en haut de la
 * fiche » la fait alors monter **entre le hero et la biographie**, en pleine
 * colonne de contenu, en pièce maîtresse. Le hero reprend exactement sa
 * composition « sans vidéo », qu'il sait déjà faire. Case décochée : rien ne
 * bouge, la vidéo reste où elle était.
 *
 * Deux emplacements, jamais les deux à la fois : `videoEnHaut` décide, et
 * l'autre ne rend rien.
 *
 * **La biographie a quitté le hero** (widgets.md §7.14) : c'est un corps libre,
 * où le rédacteur insère galeries, vidéos, questions-réponses et renvois vers
 * d'autres pages du site. Un corps qui porte tout cela n'a plus sa place dans
 * une colonne de hero — il est devenu une section à part entière, sous le hero
 * et avant l'interview.
 *
 * Le corps se lit **dans le corps de la page**, jamais dans `getStaticPaths` :
 * un nœud Markdoc est une instance d'`Ast.Node` dont `Markdoc.transform` appelle
 * les méthodes, et le faire voyager comme donnée de route est fragile
 * (widgets.md §6.4). C'est déjà ce que font la fiche arme, l'article et la fiche
 * de traité.
 *
 * Les pages sont générées depuis les encadrants **affichés** de l'école : une
 * fiche décochée dans l'admin (« Affiché sur le site ») disparaît de la grille
 * d'accueil *et* n'a plus d'URL. Aujourd'hui seule l'école principale a des
 * routes non préfixées ; le jour où une deuxième salle ouvre, ce fichier est
 * recopié en `src/pages/[ecole]/profs/[slug].astro` sans rien changer d'autre
 * (multi-ecoles.md §6.4).
 *
 * Écart assumé à la maquette : la barre d'onglets mobile n'a **aucun onglet
 * actif**. La maquette allume « CONTACT » sur une fiche prof, ce qui est faux —
 * et allumer « ACCUEIL » le serait tout autant puisqu'on n'y est pas.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import CorpsLibre from '../../components/corps/CorpsLibre.astro';
import ProfCta from '../../components/fiches/ProfCta.astro';
import ProfFilAriane from '../../components/fiches/ProfFilAriane.astro';
import ProfHero from '../../components/fiches/ProfHero.astro';
import ProfInterview from '../../components/fiches/ProfInterview.astro';
import { libelleArmes, prenomDe, profsAffiches } from '../../components/fiches/prof';
import Footer from '../../components/sections/Footer.astro';
import Nav from '../../components/sections/Nav.astro';
import TabBar from '../../components/ui/TabBar.astro';
import VideoCard from '../../components/ui/VideoCard.astro';
import type { NomIcone } from '../../components/ui/icones';
import { texteSansMarqueurs } from '../../components/ui/titre';
import Base from '../../layouts/Base.astro';
import {
  articlesDe,
  lireDisciplines,
  lireEntetes,
  lireFiches,
  lireHero,
  lireIdentite,
  lireMenus,
  profsDe,
  traitesTries,
} from '../../lib/contenu';
import { decouperCorps, texteDuCorps } from '../../lib/corps';
import { getEcolePrincipale } from '../../lib/ecoles';
import { cadrageCss, creditAffiche, resoudrePhoto } from '../../lib/images';
import { typographieFr } from '../../lib/typographie';
import { lien } from '../../lib/liens';
import { contexteDe, resoudre } from '../../lib/raccourcis';
import { indexRenvois } from '../../lib/renvois';

/** Forme d'un onglet de `TabBar` — recopiée pour ne pas typer depuis un .astro. */
interface OngletBarre {
  libelle: string;
  href: string;
  icone: NomIcone;
  exergue?: boolean;
}

export const getStaticPaths = (async () => {
  const ecole = await getEcolePrincipale();

  const [identite, hero, entetes, fiches, menus, disciplines, profs] = await Promise.all([
    lireIdentite(),
    lireHero(),
    lireEntetes(),
    lireFiches(),
    lireMenus(),
    lireDisciplines(),
    profsDe(ecole),
  ]);

  const affiches = profsAffiches(profs);
  const nbArmes = disciplines.filter((d) => d.entry.affichee).length;

  // La barre d'onglets est la même sur toutes les fiches : construite une fois.
  const onglets: OngletBarre[] = (menus.barreMobile ?? []).map((entree) => ({
    libelle: entree.libelle,
    href: lien(ecole, entree.lien),
    icone: entree.icone as NomIcone,
    // L'onglet central mis en exergue est celui des épées croisées, comme dans
    // la maquette — repéré par son icône, pas par sa position.
    exergue: entree.icone === 'swords',
  }));

  return Promise.all(
    affiches.map(async (prof) => {
      const entree = prof.entry;
      const source = `src/content/ecoles/${ecole.slug}/profs/${prof.slug}.mdoc`;
      const prenom = prenomDe(entree);

      const ctx = contexteDe(
        ecole.fiche,
        { nbArmes, nbProfs: affiches.length },
        { prof: prenom, arme: libelleArmes(entree.armes, disciplines) || undefined },
      );

      const accroche = resoudre(entree.accroche, ctx, `${source} — accroche`);

      const entretien = (entree.interview ?? []).map((qr, i) => ({
        question: resoudre(qr.question, ctx, `${source} — interview [${i + 1}] question`),
        reponse: resoudre(qr.reponse, ctx, `${source} — interview [${i + 1}] réponse`),
      }));

      return {
        params: { slug: prof.slug },
        props: {
          ecole,
          identite,
          // En-tête et pied de page du site : passés en props comme le reste,
          // aucune lecture de contenu dans le corps de la page.
          menus,
          ctaEntete: hero.boutonPrincipal,
          onglets,
          slug: prof.slug,
          // Le contexte des raccourcis est un objet de chaînes : il voyage sans
          // risque, et la biographie — lue plus bas, dans le corps de la page —
          // doit résoudre « {tarif} » comme n'importe quel autre champ du CMS
          // (ARCHITECTURE.md §7).
          ctx,
          // Le nom ne transite pas par `resoudre()` : c'est un slug de
          // collection. Sa typographie se pose ici (H1, fil d'Ariane, <title>).
          nom: typographieFr(entree.nom),
          prenom,
          armes: libelleArmes(entree.armes, disciplines),
          accroche,
          // « Accroche dorée (palmarès) » — lettres d'or sur le fragment `*…*`
          // de l'accroche (toute l'accroche s'il n'y en a pas) et ornements
          // dorés du hero. Rien d'autre ne change sur la fiche.
          accrocheDoree: Boolean(entree.accrocheDoree),
          portrait: resoudrePhoto(entree.portrait?.fichier),
          portraitAlt: entree.portrait?.alt ?? '',
          portraitPosition: cadrageCss(entree.portrait?.cadrage),
          credit: creditAffiche(entree.portrait?.credit),
          lienExterne: {
            libelle: entree.lienExterne?.libelle ?? '',
            // `lien()` laisse une URL absolue intacte et renvoie '' si le champ
            // est vide — le bouton se masque alors tout seul.
            url: lien(ecole, entree.lienExterne?.url),
          },
          video: {
            titre: entree.video?.titre ?? '',
            url: entree.video?.url ?? '',
            duree: entree.video?.duree ?? '',
            vignette: resoudrePhoto(entree.video?.vignette),
            sousTitres: entree.video?.sousTitres ?? '',
            affiche: entree.video?.affiche ?? '',
          },
          // La case « Vidéo en haut de la fiche » ne vaut que s'il y a une
          // vidéo : cochée sur un bloc vide, elle ouvrirait une section muette
          // entre le hero et la biographie.
          videoEnHaut:
            Boolean(entree.video?.enHaut) &&
            Boolean(entree.video?.url || entree.video?.vignette),
          entretien,
          rubrique: entetes.profs?.eyebrow || 'Les profs',
          retour: lien(ecole, '#profs'),
          cta: {
            titre: resoudre(fiches.prof?.titre, ctx, 'src/content/commun/fiches.yaml (prof, titre)'),
            sousTitre: resoudre(
              fiches.prof?.sousTitre,
              ctx,
              'src/content/commun/fiches.yaml (prof, sous-titre)',
            ),
            bouton: {
              libelle: fiches.prof?.bouton?.libelle ?? '',
              url: lien(ecole, fiches.prof?.bouton?.url),
            },
          },
        },
      };
    }),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const {
  ecole,
  identite,
  menus,
  ctaEntete,
  onglets,
  slug,
  ctx,
  nom,
  armes,
  accroche,
  accrocheDoree,
  portrait,
  portraitAlt,
  portraitPosition,
  credit,
  lienExterne,
  video,
  videoEnHaut,
  entretien,
  rubrique,
  retour,
  cta,
} = Astro.props as Props;

/*
 * Cadence d'apparition — l'un des raffinements de la fiche vitrine.
 *
 * Les blocs sous le hero montent de 14 px en s'opacifiant, comme les sections
 * de l'accueil. La classe `.reveal` et son observateur existent déjà
 * (global.css + Base.astro) : rien à importer, rien à instancier. Elle n'est
 * posée que sur une fiche vitrine — sur les autres, pas un attribut ne change,
 * ce qui est la condition de non-régression de cette page.
 *
 * Le hero n'en est pas : il est au-dessus de la ligne de flottaison, et faire
 * apparaître un H1 en fondu retarde la première lecture pour rien.
 */
const estVitrine = videoEnHaut || accrocheDoree;
/** `undefined` plutôt que `''` : l'attribut disparaît au lieu de rester vide. */
const cadence = estVitrine ? 'reveal' : undefined;

/**
 * Sans JavaScript, l'observateur de `Base.astro` ne passe jamais et un bloc en
 * `.reveal` resterait invisible pour toujours. Même filet que `Reveal.astro`,
 * posé ici parce que la cadence est portée par les éléments eux-mêmes, sans
 * enveloppe — et servi par `set:html` pour que la règle traverse le compilateur
 * telle quelle, sans que ses accolades soient lues comme une expression.
 */
const NEUTRALISER_REVEAL =
  '<style>.reveal{opacity:1!important;transform:none!important}</style>';

/**
 * Largeurs annoncées pour la vidéo en pièce maîtresse — trois paliers, tous
 * majorants. Un `sizes` trop petit fait choisir un dérivé trop petit, et c'est
 * alors la première image de la page qui est floue. 1 328 px = la colonne
 * pleine à 1440 ; `100vw - 82px` = la colonne moins ses deux gouttières entre
 * 1000 et 1440 ; `100vw` en dessous, majorant confortable. Le plafond en `svh`
 * posé plus bas ne peut que réduire la largeur réelle : le laisser hors du
 * calcul reste du bon côté.
 *
 * Nommé ici plutôt qu'écrit dans l'appel : un commentaire au milieu d'une liste
 * d'attributs passe le compilateur Astro mais casse `astro check`.
 */
const SIZES_VIDEO_VITRINE =
  '(min-width: 1440px) 1328px, (min-width: 1000px) calc(100vw - 82px), 100vw';

// ── La biographie et les pages qu'elle peut viser ───────────────────────────
//
// Quatre lectures, toutes mémoïsées par le Reader (`readItem` est enveloppé
// dans `cache()`) : les encadrants pour retrouver la fiche servie, et les trois
// autres collections pour l'index des renvois. Un corps libre peut pointer vers
// n'importe quelle page du site.

const [disciplines, profs, traites, articles] = await Promise.all([
  lireDisciplines(),
  profsDe(ecole),
  traitesTries(),
  articlesDe(ecole),
]);

const prof = profs.find((p) => p.slug === slug);
if (!prof) {
  throw new Error(
    `Fiche encadrant introuvable pour « /profs/${slug}/ ».\n` +
      `Les fiches vivent dans src/content/ecoles/${ecole.slug}/profs/.`,
  );
}

const sourceBio = `src/content/ecoles/${ecole.slug}/profs/${slug}.mdoc — biographie`;
const lireBio = prof.entry.bio as unknown as () => Promise<{ node: unknown }>;
const bio = await lireBio();
// Le découpage est pur : le refaire ici ne coûte qu'un parcours d'arbre, et
// c'est la seule façon de savoir si la section a quelque chose à montrer.
const aDeLaBio = decouperCorps(bio.node, sourceBio).length > 0;

const renvois = indexRenvois({ ecole, disciplines, traites, profs, articles });

// Meta description. L'accroche seule ne suffit pas : elle fait 24 à 40 signes
// (« Armes courtes & bouclier »), ce qu'un moteur remplace par un extrait de
// son cru. On la complète donc par le début de la biographie — sa **prose**
// seule : une description qui commencerait par le titre d'une vidéo ou la
// légende d'une planche ne dirait pas de qui la page parle.
//
// `texteSansMarqueurs` retire le balisage `*…*` de l'accroche : les astérisques
// qui désignent le fragment doré n'ont rien à faire dans un résultat Google.
const description = [
  texteSansMarqueurs(accroche),
  resoudre(texteDuCorps(bio.node, 200, sourceBio), ctx, sourceBio),
]
  .map((morceau) => morceau.trim())
  .filter(Boolean)
  .join(' — ')
  .slice(0, 300)
  .trim();
---

<Base ecole={ecole} identite={identite} titre={nom} description={description}>
  {/* Fiche : pas de hero photographique plein écran sous la barre, elle garde
      donc son fond plein dès le chargement. */}
  <Nav
    slot="entete"
    ecole={ecole}
    liens={menus.menuPrincipal}
    cta={ctaEntete}
    identite={identite}
    fond="solide"
  />

  <ProfFilAriane retour={retour} rubrique={rubrique} courant={nom} />

  <article class="fiche-prof" aria-labelledby="fiche-prof-titre">
    <div class:list={['fiche-prof__hero', { 'fiche-prof__hero--vitrine': videoEnHaut }]}>
      <ProfHero
        nom={nom}
        armes={armes}
        accroche={accroche}
        doree={accrocheDoree}
        portrait={portrait}
        portraitAlt={portraitAlt}
        portraitPosition={portraitPosition}
        credit={credit}
        lienExterne={lienExterne}
        retour={retour}
        libelleRetour={`Retour — ${rubrique}`}
        video={videoEnHaut ? null : video}
        idTitre="fiche-prof-titre"
      />
    </div>

    {
      videoEnHaut && (
        <section class:list={['fiche-prof__video', cadence]} aria-label={`Vidéo — ${nom}`}>
          <div class="gouttiere">
            <VideoCard
              url={video.url}
              image={video.vignette}
              alt=""
              sousTitres={video.sousTitres}
              affiche={video.affiche}
              duree={video.duree}
              titre={video.titre?.trim() || 'En vidéo'}
              taille="xl"
              ratio="16 / 9"
              rayon={3}
              vitrine
              sizes={SIZES_VIDEO_VITRINE}
              rendMax={1328}
            />
          </div>
        </section>
      )
    }

    {
      aDeLaBio && (
        <section class:list={['fiche-prof__bio', cadence]} aria-label={`Biographie de ${nom}`}>
          <div class="gouttiere">
            <CorpsLibre
              node={bio.node}
              ecole={ecole}
              ctx={ctx}
              source={sourceBio}
              renvois={renvois}
            />
          </div>
        </section>
      )
    }

    <ProfInterview entretien={entretien} class={cadence} />

    <ProfCta
      titre={cta.titre}
      sousTitre={cta.sousTitre}
      bouton={cta.bouton}
      lienExterne={lienExterne}
      doree={accrocheDoree}
      class={cadence}
    />
  </article>

  {/* Le filet sans JavaScript de la cadence — cf. `NEUTRALISER_REVEAL`. */}
  {estVitrine && <noscript set:html={NEUTRALISER_REVEAL} />}

  <Fragment slot="pied">
    <Footer ecole={ecole} identite={identite} menus={menus} />
    {/* La barre d'onglets rend sa propre cale : elle vient après le pied de
        page, sinon celui-ci passerait dessous. */}
    <TabBar onglets={onglets} libelle="Navigation rapide du site" />
  </Fragment>
</Base>

<style>
  .fiche-prof {
    background: var(--ink);
  }

  /*
   * Mobile : le hero est plein cadre et arrive tout en haut (design-spec §6.4).
   * Les 26 px du bas sont ceux du bloc `Bio` de la maquette : ils étaient en
   * fait fournis par `ProfInterview`, masqué tant qu'aucune question n'est
   * saisie — le filet haut de la bande CTA atterrissait alors sur les jambages
   * de la dernière ligne du bloc précédent. On les pose ici, où ils ne dépendent
   * de rien.
   *
   * Desktop : 72 px sous le fil d'Ariane, 88 px avant le bloc suivant (§6.3).
   *
   * La biographie porte **le même bas de bloc**, et rien d'autre : les deux
   * sections se suivent au même rythme, et retirer l'une ne change pas
   * l'espacement de l'autre.
   */
  .fiche-prof__hero,
  .fiche-prof__bio,
  .fiche-prof__video {
    padding-block: 0 26px;
  }

  @media (min-width: 1000px) {
    .fiche-prof__hero {
      padding-block: clamp(40px, 1rem + 3vw, 72px) clamp(48px, 1rem + 3.6vw, 88px);
    }

    .fiche-prof__bio,
    .fiche-prof__video {
      padding-block: 0 clamp(48px, 1rem + 3.6vw, 88px);
    }
  }

  /*
   * Quand la vidéo monte en tête, elle prolonge le hero au lieu d'ouvrir un
   * chapitre : l'écart se resserre, pour que le portrait, le nom et la vidéo se
   * lisent comme un seul bloc, et que la respiration pleine soit gardée pour
   * l'entrée dans la biographie.
   */
  .fiche-prof__hero--vitrine {
    padding-block-end: 16px;
  }

  @media (min-width: 1000px) {
    .fiche-prof__hero--vitrine {
      padding-block-end: clamp(26px, 1rem + 1.8vw, 46px);
    }
  }

  /*
   * Le grand lecteur ne dépasse jamais la fenêtre.
   *
   * En pleine colonne à 1440 px, un cadre 16/9 fait 1 328 × 747. Ajoutez la
   * barre de navigation collante (76 px) et la légende (40 px) : il faut une
   * fenêtre de 863 px de haut pour voir la vidéo ET la barre de commandes du
   * lecteur. Sous cette taille, les commandes tombent sous le pli — et comme
   * elles se masquent d'elles-mêmes pendant la lecture, on ne peut même plus
   * les faire revenir au survol.
   *
   * On borne donc la largeur par la hauteur disponible. Les 168 px retranchés
   * sont ces deux réserves plus un peu d'air : un écran 1080p en plein écran
   * garde toute la colonne, un portable 1440 × 900 cale la vidéo vers 1 120 px.
   * `svh` et non `vh` : sur mobile, `vh` compte la barre d'adresse rétractée et
   * ment de 60 à 100 px. Le calage reste à gauche, comme tout le reste de la
   * page — jamais un bloc centré au milieu d'une colonne alignée.
   */
  @media (min-width: 1000px) {
    .fiche-prof__video :global(.video-card) {
      max-width: calc((100svh - 168px) * 16 / 9);
    }
  }
</style>
