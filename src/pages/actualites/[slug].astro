---
/**
 * `/actualites/<slug>/` — la page d'un article. Gabarit NON maquetté
 * (design-spec §10.2), calqué sur le gabarit « Fiche arme » qui, lui, l'est :
 *
 *   1. fil d'Ariane à filet bas — « Retour » à gauche, chemin à droite (§5.3) ;
 *   2. tête : ligne « era » (tiret ember + catégorie + · + date), H1 Cormorant
 *      en `--fs-display-fiche`, chapô en `$body` 18 / lh 1.4 / `$parch-soft` ;
 *   3. couverture pleine largeur, rayon 3, crédit photo en légende ;
 *   4. corps markdoc rendu en HTML, mesure bornée à 58ch (~80 signes) ;
 *   5. blocs facultatifs « Photos » et « Liens utiles », avec la tête à filet
 *      du « Mini-cours » (eyebrow ember ◆ précision `$parch-mute`) ;
 *   6. pied à filet haut : retour à la liste + articles voisins ;
 *   7. barre d'onglets mobile : chrome global, rendue sur toutes les pages.
 *
 * Toute la page est en `$ink` : sur une page de détail, le rythme vient des
 * filets et de l'espacement, pas de l'alternance de fonds (design-spec §5.1).
 *
 * **Brouillons** : `getStaticPaths` ne génère que les articles `statut:
 * publie`. Un brouillon n'a donc **pas d'URL sur le site** : rien à `noindex`,
 * aucun lien deviné n'y mène. Ce n'est pas pour autant confidentiel — le texte
 * est écrit dans le dépôt dès l'enregistrement, et le dépôt est public. Un
 * brouillon est « pas encore publié », pas « secret ».
 *
 * Le corps est un **corps libre** (widgets.md §0) : du texte, et des widgets
 * insérés où le rédacteur veut. Il est rendu par `CorpsLibre`, qui a remplacé le
 * parcours d'arbre Markdoc écrit ici quand le dépôt n'avait pas de rendu
 * partagé. Les blocs « Photos » et « Liens utiles » de bas de page, eux, restent
 * des **champs de la fiche**, à place fixe : le widget « Galerie de photos »
 * sert à intercaler des photos *dans* le fil du texte.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CorpsLibre from '../../components/corps/CorpsLibre.astro';
import Footer from '../../components/sections/Footer.astro';
import FilArianeSources from '../../components/sources/FilArianeSources.astro';
import Nav from '../../components/sections/Nav.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import TabBar from '../../components/ui/TabBar.astro';
import { estNomIcone } from '../../components/ui/icones';
import {
  articlesDe,
  lireDisciplines,
  lireHero,
  lireIdentite,
  lireMenus,
  profsDe,
  traitesTries,
  type Article,
} from '../../lib/contenu';
import { getEcolePrincipale } from '../../lib/ecoles';
import { decouperCorps } from '../../lib/corps';
import { cadrageCss, creditAffiche, largeursSrcset, resoudrePhoto } from '../../lib/images';
import { typographieFr } from '../../lib/typographie';
import { estExterne, lien, lienArticle, lienProf } from '../../lib/liens';
import { contexteDe } from '../../lib/raccourcis';
import { indexRenvois, libelleCategorie } from '../../lib/renvois';

/**
 * Une URL par article publié. Aucune route n'est créée pour les brouillons.
 *
 * L'école principale est la seule servie à la racine aujourd'hui : le jour où
 * une deuxième salle ouvre, c'est une route `/[ecole]/actualites/[slug]` qui
 * apparaît, sans toucher à ce fichier (ARCHITECTURE.md §3, multi-ecoles §6.4).
 */
export async function getStaticPaths() {
  const ecole = await getEcolePrincipale();
  const articles = await articlesDe(ecole);
  return articles
    .filter((a) => a.entry.statut === 'publie')
    .map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const ecole = await getEcolePrincipale();
const [identite, hero, menus, articles, profs, disciplines, traites] = await Promise.all([
  lireIdentite(),
  lireHero(),
  lireMenus(),
  articlesDe(ecole),
  profsDe(ecole),
  lireDisciplines(),
  // Pour l'index des renvois seulement : un corps libre peut renvoyer vers
  // n'importe quelle page du site, traités compris.
  traitesTries(),
]);

// Contexte des raccourcis : le corps d'un article est un champ de texte riche
// comme la biographie d'un prof ou une réponse de FAQ, et « {email} » doit s'y
// résoudre pareil. Mêmes compteurs que l'accueil (ARCHITECTURE.md §4).
// À noter : `{arme}` et `{prof}` n'existent que sur une fiche — les employer
// ici fait échouer le build avec le nom du fichier, ce qui est le comportement
// voulu (ARCHITECTURE.md §7), pas un affichage littéral en production.
const ctx = contexteDe(ecole.fiche, {
  nbArmes: disciplines.filter((d) => d.entry.affichee).length,
  nbProfs: profs.filter((p) => p.entry.visible).length,
});

// Barre d'onglets mobile : c'est du chrome global, présent sur toutes les pages
// du site. Aucun onglet n'est actif sur un article — la barre n'a pas d'entrée
// « Actualités » —, et l'onglet central mis en exergue reste celui des épées
// croisées, repéré par son icône et non par sa position.
const onglets = (menus.barreMobile ?? []).map((onglet) => ({
  libelle: onglet.libelle,
  href: lien(ecole, onglet.lien),
  icone: estNomIcone(onglet.icone) ? onglet.icone : 'house',
  exergue: onglet.icone === 'swords',
}));

const parDate = (a: Article, b: Article) => (b.entry.date ?? '').localeCompare(a.entry.date ?? '');

// Ordre strictement antéchronologique : c'est lui qui définit « plus récent »
// et « plus ancien » en pied de page (l'épinglage ne concerne que la liste).
const chronologie = [...articles].filter((a) => a.entry.statut === 'publie').sort(parDate);

const rang = chronologie.findIndex((a) => a.slug === slug);
if (rang === -1) {
  throw new Error(
    `Article introuvable pour « /actualites/${slug}/ ».\n` +
      'La page n’est générée que pour les articles au statut « Publié » ' +
      `(src/content/ecoles/${ecole.slug}/articles/).`,
  );
}

const article = chronologie[rang]!;
const entree = article.entry;

const plusRecent = rang > 0 ? chronologie[rang - 1] : null;
const plusAncien = rang < chronologie.length - 1 ? chronologie[rang + 1] : null;

// ── Habillage ───────────────────────────────────────────────────────────────

/*
 * Les libellés de catégorie vivent dans `src/lib/renvois.ts` : une carte de
 * renvoi vers un article les affiche en sur-titre, et deux tables parallèles
 * auraient fini par diverger.
 */

const FORMAT_DATE = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/** « 2026-07-28 » → « 28 juillet 2026 ». Midi UTC : aucun décalage de jour. */
const dateLisible = (iso?: string | null) =>
  iso ? FORMAT_DATE.format(new Date(`${iso}T12:00:00Z`)) : '';

/** Politique de largeurs commune (src/lib/images.ts) : les candidats trop
    grands sont écartés, mais la largeur native est alors servie. */
const largeurs = (image: ImageMetadata, souhaitees: number[]) =>
  largeursSrcset(image, { largeurs: souhaitees });

const categorie = libelleCategorie(entree.categorie);
const date = dateLisible(entree.date);
// Titre, chapô et signature sont des champs libres du CMS : sans raccourcis,
// donc sans passage par `resoudre()`. Leur typographie se pose ici — c'est le
// H1 de l'article, son `<title>`, son fil d'Ariane et sa méta description.
const titreArticle = typographieFr(entree.titre);
const chapo = typographieFr(entree.chapo);

const couverture = resoudrePhoto(entree.couverture?.fichier);
const couvertureAlt = entree.couverture?.alt ?? '';
const couvertureCadrage = cadrageCss(entree.couverture?.cadrage);
const couvertureCredit = creditAffiche(entree.couverture?.credit);

const auteur = entree.auteur ? (profs.find((p) => p.slug === entree.auteur) ?? null) : null;
const auteurVisible = auteur && auteur.entry.visible ? auteur : null;

interface PhotoGalerie {
  image: ImageMetadata;
  alt: string;
  cadrage: string;
  credit: string;
}

// `flatMap` plutôt que `map().filter()` : une photo dont le fichier n'a pas
// (encore) été déposé disparaît de la galerie sans casser le build ni laisser
// un cadre vide (cf. src/lib/images.ts).
const galerie: PhotoGalerie[] = (entree.galerie ?? []).flatMap((photo) => {
  const image = resoudrePhoto(photo?.fichier);
  if (!image) return [];
  return [
    {
      image,
      alt: photo?.alt ?? '',
      cadrage: cadrageCss(photo?.cadrage),
      credit: creditAffiche(photo?.credit),
    },
  ];
});

const liensUtiles = (entree.liens ?? []).filter((l) => l?.libelle && l?.url);

/** Sortant = nouvel onglet. `mailto:` et `tel:` n'ouvrent pas d'onglet. */
const estSortant = (url: string) =>
  estExterne(url) && !url.startsWith('mailto:') && !url.startsWith('tel:');

// ── Le corps ────────────────────────────────────────────────────────────────
//
// Le Reader Keystatic rend le corps sous sa forme *analysée* : un arbre Markdoc
// (`{ node }`), pas du HTML. Il est découpé et rendu par `CorpsLibre` — prose et
// widgets, dans l'ordre où le rédacteur les a posés (widgets.md §4). Les trente
// lignes de parcours d'arbre qui vivaient ici ont fondu dedans : c'était le plus
// complet des trois parcours du dépôt (images passées par `astro:assets`), et
// c'est lui qui a servi de référence.

const contenu = await entree.corps();
const sourceCorps = `src/content/ecoles/${ecole.slug}/articles/${slug}.mdoc — corps`;
const aDuCorps = decouperCorps(contenu.node, sourceCorps).length > 0;

/**
 * Les pages qu'un widget « Renvoi » peut viser depuis le corps de l'article.
 *
 * L'index est bâti ici et passé en props : ni `CorpsLibre` ni `renvois.ts` ne
 * lisent de contenu (multi-ecoles.md §6.6, invariants 3 et 4). Il est fourni
 * même quand aucun article ne porte encore de renvoi — l'oublier ferait passer
 * pour cassé le premier renvoi qu'un rédacteur poserait.
 */
const renvois = indexRenvois({ ecole, disciplines, traites, profs, articles });

const nbPhotos =
  galerie.length === 1 ? '1 photo' : galerie.length > 1 ? `${galerie.length} photos` : '';
---

<Base
  ecole={ecole}
  identite={identite}
  titre={titreArticle}
  description={chapo || undefined}
  typeOg="article"
>

  {/* Page sans hero photographique : la barre garde son fond plein dès le
      chargement (`fond="solide"`, cf. notes du chantier « chrome »). */}
  <Nav
    slot="entete"
    ecole={ecole}
    liens={menus.menuPrincipal}
    cta={hero.boutonPrincipal}
    identite={identite}
    fond="solide"
  />
  {/* Fil d'Ariane : composant partagé — cf. la liste d'actualités. */}
  <FilArianeSources
    retourHref={lien(ecole, '/actualites/')}
    chemin={[{ libelle: 'Actualités', href: lien(ecole, '/actualites/') }, { libelle: titreArticle }]}
  />

  <article class="article">
    <header class="tete">
      {/* La mesure est bornée sur un enfant, jamais sur `.gouttiere` : cette
          dernière porte `margin-inline: auto`, et lui réduire sa largeur
          recentrerait tout le bloc de tête au lieu de le laisser sur la grille
          de gauche, comme la couverture et le corps. */}
      <div class="gouttiere">
        <div class="tete__bloc">
          <p class="era">
            <span class="era__tiret" aria-hidden="true"></span>
            {categorie && <span class="era__categorie">{categorie}</span>}
            {categorie && date && (
              <span class="era__point" aria-hidden="true">·</span>
            )}
            {date && <time class="era__date" datetime={entree.date ?? undefined}>{date}</time>}
          </p>

          <SectionTitle balise="h1" taille="fiche" lignes={[{ texte: titreArticle }]} />

          {chapo && <p class="tete__chapo">{chapo}</p>}

          {
            auteurVisible && (
              <p class="tete__auteur">
                <span class="tete__par">Par</span>
                <a class="tete__prof" href={lienProf(ecole, auteurVisible.slug)}>
                  {typographieFr(auteurVisible.entry.nom)}
                </a>
              </p>
            )
          }
        </div>
      </div>
    </header>

    {
      couverture && (
        <figure class="couverture">
          <div class="gouttiere">
            <div class="couverture__cadre">
              <Picture
                src={couverture}
                alt={couvertureAlt}
                formats={['avif', 'webp']}
                widths={largeurs(couverture, [390, 720, 1000, 1328, 1800, 2400])}
                sizes="(min-width: 1440px) 1328px, 92vw"
                loading="eager"
                decoding="async"
                style={`object-position:${couvertureCadrage}`}
              />
            </div>
            {couvertureCredit && (
              <figcaption class="couverture__credit">{couvertureCredit}</figcaption>
            )}
          </div>
        </figure>
      )
    }

    {
      aDuCorps && (
        <div class="gouttiere">
          <div class="corps">
            <CorpsLibre
              node={contenu.node}
              ecole={ecole}
              ctx={ctx}
              source={sourceCorps}
              renvois={renvois}
            />
          </div>
        </div>
      )
    }

    {
      galerie.length > 0 && (
        <section class="bloc" aria-labelledby="bloc-photos">
          <div class="gouttiere">
            <div class="bloc__tete">
              <span class="bloc__label" id="bloc-photos">
                Photos
              </span>
              <Icon name="diamond" size={6} />
              <span class="bloc__precision">{nbPhotos}</span>
            </div>

            <ul class="galerie" role="list">
              {galerie.map((photo) => (
                <li class="galerie__item">
                  <figure class="galerie__figure">
                    <div class="galerie__cadre">
                      <Picture
                        src={photo.image}
                        alt={photo.alt}
                        formats={['avif', 'webp']}
                        widths={largeurs(photo.image, [280, 340, 500, 680, 900])}
                        sizes="(min-width: 820px) 30vw, 90vw"
                        loading="lazy"
                        decoding="async"
                        style={`object-position:${photo.cadrage}`}
                      />
                    </div>
                    {photo.credit && (
                      <figcaption class="galerie__credit">{photo.credit}</figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      liensUtiles.length > 0 && (
        <section class="bloc" aria-labelledby="bloc-liens">
          <div class="gouttiere">
            <div class="bloc__tete">
              <span class="bloc__label" id="bloc-liens">
                Liens utiles
              </span>
              <Icon name="diamond" size={6} />
              <span class="bloc__precision">Pour aller plus loin</span>
            </div>

            <ul class="liens" role="list">
              {liensUtiles.map((l) => (
                <li>
                  <Button
                    variante="contour"
                    taille="petite"
                    libelle={l.libelle ?? ''}
                    href={lien(ecole, l.url)}
                    externe={estSortant(l.url ?? '')}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <footer class="pied">
      <div class="gouttiere pied__rangee">
        <Button
          variante="contour"
          libelle="Toutes les actualités"
          href={lien(ecole, '/actualites/')}
        />

        {
          (plusRecent || plusAncien) && (
            <nav class="voisins" aria-label="Autres articles">
              {plusRecent && (
                <a class="voisin" href={lienArticle(ecole, plusRecent.slug)}>
                  <span class="voisin__label">Plus récent</span>
                  <span class="voisin__titre">{typographieFr(plusRecent.entry.titre)}</span>
                </a>
              )}
              {plusAncien && (
                <a class="voisin" href={lienArticle(ecole, plusAncien.slug)}>
                  <span class="voisin__label">Plus ancien</span>
                  <span class="voisin__titre">{typographieFr(plusAncien.entry.titre)}</span>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </footer>
  </article>

  <Fragment slot="pied">
    <Footer ecole={ecole} identite={identite} menus={menus} />
    {/* La barre d'onglets rend sa propre cale : elle vient après le pied de
        page, sinon celui-ci passerait dessous. */}
    <TabBar onglets={onglets} libelle="Navigation rapide du site" />
  </Fragment>
</Base>

<style>
  /* ── Fil d'Ariane (design-spec §5.3) ─────────────────────────────────────── */










  /* Un titre d'article est bien plus long qu'un nom d'arme : il se tronque
     plutôt que de pousser le fil d'Ariane sur deux lignes. */

  @media (max-width: 619px) {
    .fil__chemin li:not(:last-child) {
      display: none;
    }

  }

  /* ── Tête de l'article ───────────────────────────────────────────────────── */

  /* Enfant de `.gouttiere`, jamais la gouttière elle-même : celle-ci est
     centrée par `margin-inline: auto` (global.css), et lui poser un `max-width`
     de mesure décalait toute la tête vers le centre — à 430 px de la couverture
     et du corps, calés eux sur la grille de gauche. */
  .tete__bloc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(12px, 9.029px + 0.7619vw, 20px);
    max-width: 60ch;
    padding-block: clamp(40px, 20.686px + 4.9524vw, 92px)
      clamp(26px, 16.343px + 2.4762vw, 52px);
  }

  /* Ligne « era » — tiret ember + catégorie + · + date (design-spec §5.3).
     ls 2,9 à 10,5 px, comme la ligne era de la fiche arme (`ArmeHero`) :
     2,9 / 10,5 = 0.276em, et non les 2,94 de `--ls-eyebrow`. */
  .era {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-eyebrow);
    font-size: var(--fs-eyebrow-s);
    font-weight: 600;
    letter-spacing: 0.276em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .era__tiret {
    width: 22px;
    height: 1px;
    flex: none;
    background: var(--ember);
  }

  .era__categorie {
    color: var(--ember);
  }

  .era__point,
  .era__date {
    color: var(--parch-mute);
    font-weight: 400;
    letter-spacing: var(--ls-eyebrow-s);
  }

  .tete__chapo {
    max-width: 56ch;
    margin: 0;
    font-size: var(--fs-body-lede);
    line-height: 1.5;
    color: var(--parch-soft);
  }

  .tete__auteur {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: 1.4;
  }

  .tete__par {
    color: var(--parch-mute);
  }

  .tete__prof {
    color: var(--parch);
    text-decoration: underline;
    text-decoration-color: var(--parch-line);
    transition: color var(--transition);
  }

  .tete__prof:hover,
  .tete__prof:focus-visible {
    color: var(--ember-hot);
    text-decoration-color: var(--ember-hot);
  }

  /* ── Couverture ──────────────────────────────────────────────────────────── */

  .couverture {
    margin: 0;
  }

  .couverture__cadre {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2);
    background: var(--char);
  }

  .couverture__cadre :global(picture),
  .couverture__cadre :global(img) {
    width: 100%;
    height: 100%;
  }

  .couverture__cadre :global(img) {
    object-fit: cover;
  }

  .couverture__credit {
    padding-block-start: 10px;
    font-family: var(--font-eyebrow);
    font-size: var(--fs-eyebrow-s);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow-s);
    text-align: right;
    color: var(--parch-mute);
  }

  /* ── Corps de l'article ──────────────────────────────────────────────────── */

  /* Le corps est rendu par `CorpsLibre`, qui porte sa mesure (58ch), sa
     typographie et le rythme de ses blocs. Il ne reste ici que la respiration
     de la section : la borner en largeur écraserait aussi les widgets, plus
     larges que la prose à dessein. */
  .corps {
    padding-block: clamp(34px, 19.886px + 3.619vw, 72px);
  }

  /* ── Blocs « Photos » / « Liens utiles » (tête du Mini-cours, §5.3) ──────── */

  .bloc {
    padding-block-end: clamp(34px, 19.886px + 3.619vw, 72px);
  }

  .bloc__tete {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block-end: clamp(18px, 16.514px + 0.381vw, 22px);
    border-bottom: var(--filet);
    font-family: var(--font-eyebrow);
    font-size: var(--fs-eyebrow-s);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ember);
  }

  .bloc__precision {
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow-s);
    color: var(--parch-mute);
  }

  .galerie {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    padding-block-start: clamp(20px, 14.429px + 1.4286vw, 36px);
    list-style: none;
  }

  .galerie__figure {
    margin: 0;
  }

  .galerie__cadre {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-2);
    background: var(--char);
  }

  .galerie__cadre :global(picture),
  .galerie__cadre :global(img) {
    width: 100%;
    height: 100%;
  }

  .galerie__cadre :global(img) {
    object-fit: cover;
  }

  .galerie__credit {
    padding-block-start: 8px;
    font-family: var(--font-eyebrow);
    font-size: var(--fs-eyebrow-s);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow-s);
    color: var(--parch-mute);
  }

  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 8.514px + 0.381vw, 14px);
    margin: 0;
    padding: 0;
    padding-block-start: clamp(20px, 14.429px + 1.4286vw, 36px);
    list-style: none;
  }

  /* ── Pied d'article ──────────────────────────────────────────────────────── */

  .pied {
    border-top: var(--filet);
  }

  .pied__rangee {
    display: flex;
    flex-wrap: wrap;
