---
/**
 * VideoCard — vignette vidéo (mini-cours de fiche arme, interview de prof).
 *
 * Huit occurrences maquettées (design-spec §9.9, §5.3 « Mini-cours », §6.3
 * « Interview ») : vignette en `cover`, voile 40 %, pastille `play` parfaitement
 * centrée, badge de durée en bas à droite, puis titre et sous-libellé.
 *
 * **Masquable.** Les blocs vidéo sont vides tant que le club n'a rien tourné
 * (ARCHITECTURE.md §1). Sans URL ni vignette, le composant ne rend rien —
 * la page n'a donc pas à tester quoi que ce soit avant de l'appeler. Pour
 * afficher un emplacement « à venir » (page de démonstration, aperçu CMS),
 * passer `masquerSiVide={false}`.
 *
 * Aucun lecteur embarqué : la vignette est un lien sortant. Zéro cookie tiers,
 * conforme à la promesse RGPD du site (ARCHITECTURE.md §6).
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { largeursSrcset } from '../../lib/images';

export interface Props {
  /** URL de la vidéo (YouTube, PeerTube…). Vide = bloc masqué. */
  url?: string | null;
  /** Vignette importée (`astro:assets`). */
  image?: ImageMetadata | null;
  /** Repli : URL d'une image du dossier `public/`. */
  src?: string | null;
  alt?: string;
  objectPosition?: string;
  /** Durée affichée dans le badge, ex. « 04:12 ». */
  duree?: string | null;
  titre?: string;
  /** Sous-libellé en capitales, ex. « BASES · POSTURE & DISTANCES ». */
  sousTitre?: string;
  /** 46 px (mobile) · 54 px (mini-cours desktop) · 64 px (interview desktop). */
  taille?: 's' | 'm' | 'l';
  ratio?: string;
  rayon?: 0 | 1 | 2 | 3;
  /** `false` pour rendre un emplacement vide au lieu de disparaître. */
  masquerSiVide?: boolean;
  /** Texte de l'emplacement vide. */
  texteVide?: string;
  charge?: 'lazy' | 'eager';
  sizes?: string;
  largeurs?: number[];
  /** Largeur CSS maximale du cadre — plafonne l'échelle par défaut à `2 ×`. */
  rendMax?: number;
  class?: string;
}

const {
  url = null,
  image = null,
  src = null,
  alt = '',
  objectPosition = '50% 50%',
  duree = null,
  titre,
  sousTitre,
  taille = 'm',
  ratio = '16 / 9',
  rayon = 3,
  masquerSiVide = true,
  texteVide = 'Vidéo à venir',
  charge = 'lazy',
  sizes = '(min-width: 820px) 33vw, 92vw',
  largeurs,
  rendMax = 640,
  class: classe,
} = Astro.props;

const aVignette = Boolean(image || src);
const aVideo = Boolean(url);
const afficher = aVideo || aVignette || !masquerSiVide;

// Politique de largeurs commune (src/lib/images.ts) : vignette vidéo de 640 px
// au plus (photos.md §5.4).
const largeursFinales = largeursSrcset(image, { largeurs, rendMax });

// Le cadre est un lien quand la vidéo existe, un simple bloc sinon.
const Cadre = aVideo ? 'a' : 'div';
const attributsCadre = aVideo ? { href: url as string, target: '_blank', rel: 'noopener noreferrer' } : {};

// Le libellé accessible du lien doit dire ce qu'on ouvre, pas « lire ».
const libelleAccessible = [titre ? `Voir la vidéo : ${titre}` : 'Voir la vidéo', duree ? `(${duree})` : '']
  .filter(Boolean)
  .join(' ');
---

{
  afficher && (
    <figure class:list={['video-card', classe]} data-taille={taille} style={`--video-ratio:${ratio};--video-rayon:${rayon}px;--video-position:${objectPosition}`}>
      <Cadre class="video-card__cadre" {...attributsCadre} aria-label={aVideo ? libelleAccessible : undefined}>
        <div class="video-card__media">
          {image ? (
            <Picture
              src={image}
              alt={aVideo ? '' : alt}
              formats={['avif', 'webp']}
              widths={largeursFinales}
              sizes={sizes}
              loading={charge}
              decoding="async"
            />
          ) : src ? (
            <img src={src} alt={aVideo ? '' : alt} loading={charge} decoding="async" />
          ) : (
            <div class="video-card__vide" aria-hidden="true" />
          )}
        </div>

        <div class="video-card__voile" aria-hidden="true" />

        <span class="video-card__play" data-inactif={aVideo ? undefined : ''} aria-hidden="true">
          <Icon name="play" />
        </span>

        {duree && <span class="video-card__duree">{duree}</span>}

        {!aVideo && <span class="video-card__mention">{texteVide}</span>}
      </Cadre>

      {(titre || sousTitre) && (
        <figcaption class="video-card__legende">
          {titre && <span class="video-card__titre">{titre}</span>}
          {sousTitre && <span class="video-card__soustitre">{sousTitre}</span>}
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 0.4rem + 0.5vw, 14px);
    margin: 0;
  }

  .video-card__cadre {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--video-ratio);
    border-radius: var(--video-rayon);
    background: var(--char);
    color: inherit;
    text-decoration: none;
  }

  .video-card__media {
    position: absolute;
    inset: 0;
  }

  .video-card__media :global(picture),
  .video-card__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .video-card__media :global(img) {
    object-fit: cover;
    object-position: var(--video-position);
    transition: transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .video-card__vide {
    width: 100%;
    height: 100%;
    background: var(--char);
  }

  .video-card__voile {
    position: absolute;
    inset: 0;
    background: var(--veil-40);
  }

  /* Pastille « play » : cercle parchemin, icône encre, centrage parfait. */
  .video-card__play {
    /* `Icon.astro` se dimensionne par la variable héritée `--icone-cote` : son
       style scopé l'emporterait sur un `:global(svg)` écrit ici. */
    --icone-cote: var(--video-play-icone, 20px);
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--video-play, 54px);
    height: var(--video-play, 54px);
    border-radius: var(--radius-pill);
    background: var(--parch);
    color: var(--ink);
    transform: translate(-50%, -50%);
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  .video-card__play :global(svg) {
    /* Le triangle de `play` paraît décentré dans un cercle : 1 px le corrige. */
    margin-left: 1px;
  }

  /* Emplacement vide : pas de vidéo derrière, la pastille reste discrète. */
  .video-card__play[data-inactif] {
    background: var(--surface-2);
    color: var(--parch-mute);
  }

  .video-card[data-taille='s'] {
    --video-play: 46px;
    --video-play-icone: 17px;
  }
  .video-card[data-taille='m'] {
    --video-play: clamp(46px, 2rem + 1.4vw, 54px);
    --video-play-icone: clamp(17px, 0.7rem + 0.5vw, 20px);
  }
  .video-card[data-taille='l'] {
    --video-play: clamp(46px, 2rem + 2.4vw, 64px);
    --video-play-icone: clamp(17px, 0.7rem + 0.9vw, 24px);
  }

  .video-card__duree {
    position: absolute;
    right: clamp(12px, 0.6rem + 0.2vw, 14px);
    bottom: clamp(12px, 0.6rem + 0.2vw, 14px);
    padding: 4px 9px;
    border-radius: var(--radius-pill);
    background: var(--veil-ink-80);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.4;
    color: var(--parch);
    font-variant-numeric: tabular-nums;
  }

  .video-card__mention {
    position: absolute;
    left: 50%;
    bottom: clamp(12px, 0.6rem + 0.2vw, 16px);
    font-family: var(--font-eyebrow);
    font-size: var(--fs-eyebrow-s);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow-s);
    text-transform: uppercase;
    color: var(--parch-mute);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .video-card__legende {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .video-card__titre {
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.3;
    color: var(--parch);
  }

  .video-card__soustitre {
    font-family: var(--font-eyebrow);
    font-size: clamp(8.5px, 8.1px + 0.1vw, 9.5px);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow-s);
    text-transform: uppercase;
    color: var(--parch-mute);
  }

  a.video-card__cadre:hover .video-card__play,
  a.video-card__cadre:focus-visible .video-card__play {
    background: var(--ember-hot);
    transform: translate(-50%, -50%) scale(1.06);
  }

  a.video-card__cadre:hover .video-card__media :global(img) {
    transform: scale(1.04);
  }

  a.video-card__cadre:focus-visible {
    outline: 2px solid var(--ember-hot);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-card__play,
    .video-card__media :global(img) {
      transition: none;
    }

    a.video-card__cadre:hover .video-card__play,
    a.video-card__cadre:focus-visible .video-card__play {
      transform: translate(-50%, -50%);
    }

    a.video-card__cadre:hover .video-card__media :global(img) {
      transform: none;
    }
  }
</style>
