  /* ═══ Fenêtres basses ═══════════════════════════════════════════════════ */
  /* Téléphone tenu couché, fenêtre réduite, navigateur intégré d'une
     application : le film garde ses cinq cartons et ce qu'ils disent ; il
     compacte. */
  @media (max-height: 520px) {
    .film__registre {
      --film-nombre: min(72px, 15vh);
    }

    .film__rang {
      padding-block: 1.4vh;
