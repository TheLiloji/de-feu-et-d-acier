        }
        <span class="film__voile"></span>
      </div>
      <div class="film__bloc">
        <p class="film__losange" data-anime="losange-2">◆</p>
        <p class="film__titre">
          <span class="film__masque"><span class="film__ligne" data-anime="titre-2a">Un club qui grandit</span></span>
          <span class="film__masque"><span class="film__ligne film__ligne--accent" data-anime="titre-2b">vite</span></span>
        </p>
        <div class="film__chiffres">
          <p class="film__chiffre" data-anime="chiffre-60">
            <span class="film__nombre" data-compte="60" style="min-inline-size:2ch">60</span>
            <span class="film__libelle">adhérents</span>
          </p>
          <p class="film__chiffre" data-anime="chiffre-27">
            <span class="film__nombre" data-compte="27" style="min-inline-size:2ch">27</span>
            <span class="film__libelle">nouveaux cette rentrée</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* ── Scène 3 : le palmarès — l'or n'est permis qu'ici ──────────────── */}
  <div class="film__scene film__scene--palmares" data-scene="3" aria-hidden="true">
    <div class="film__compo film__compo--panneau film__compo--palmares">
      <div class="film__cadre film__cadre--palmares" data-cadre="3">
        {
          photoPodium && (
            <Picture
              src={photoPodium}
              alt=""
              formats={['avif', 'webp']}
              widths={largeursSrcset(photoPodium, { largeurs: [480, 720, 960] })}
              sizes="(min-width: 820px) 360px, 92vw"
              loading="eager"
              decoding="async"
            />
          )
        }
        <span class="film__voile"></span>
      </div>
      <div class="film__bloc">
        <p class="film__titre">
          <span class="film__masque"><span class="film__ligne" data-anime="titre-3a">Des résultats</span></span>
          <span class="film__masque"><span class="film__ligne film__ligne--accent" data-anime="titre-3b">qui se voient</span></span>
        </p>
        <span class="film__filet film__filet--or" data-anime="filet-3"></span>
        <p class="film__or-rang" data-anime="or-1">
          <span class="film__or">80ᵉ mondial · 3ᵉ combattant français<span
              class="film__balayage film__balayage--or"
              data-anime="balayage-or"
              >80ᵉ mondial · 3ᵉ combattant français</span
            ></span>
        </p>
        <p class="film__or-titres" data-anime="or-2">2 titres de champion fédéral</p>
      </div>
    </div>
  </div>

  {/* ── Scène 4 : votre logo sur nos couleurs ─────────────────────────── */}
  <div class="film__scene film__scene--couleurs" data-scene="4" aria-hidden="true">
    <div class="film__compo film__compo--panneau">
      <div class="film__cadre film__cadre--couleurs" data-cadre="4">
        {
          photoCouleurs && (
            <Picture
              src={photoCouleurs}
              alt=""
              formats={['avif', 'webp']}
              widths={largeursSrcset(photoCouleurs, { largeurs: [520, 780, 1050] })}
              sizes="(min-width: 820px) 48vw, 92vw"
              loading="eager"
              decoding="async"
            />
          )
        }
        <span class="film__voile"></span>
      </div>
      <div class="film__bloc">
        <p class="film__titre">
          <span class="film__masque"><span class="film__ligne" data-anime="titre-4a">Votre logo</span></span>
          <span class="film__masque"><span class="film__ligne film__ligne--accent" data-anime="titre-4b">sur nos couleurs</span></span>
        </p>
        <p class="film__mots">
          <span class="film__masque film__masque--mot"><span class="film__motcle" data-anime="mot-1"><span class="film__motcle-losange">◆</span>affiches</span></span>
          <span class="film__masque film__masque--mot"><span class="film__motcle" data-anime="mot-2"><span class="film__motcle-losange">◆</span>bannières</span></span>
          <span class="film__masque film__masque--mot"><span class="film__motcle" data-anime="mot-3"><span class="film__motcle-losange">◆</span>réseaux</span></span>
          <span class="film__masque film__masque--mot"><span class="film__motcle" data-anime="mot-4"><span class="film__motcle-losange">◆</span>événements</span></span>
        </p>
      </div>
    </div>
  </div>

  {/* ── Scène 5 : devenez partenaire — la seule scène annoncée ────────── */}
  <div class="film__scene film__scene--finale" data-scene="5">
    <div class="film__fond" aria-hidden="true" data-anime="fond-5">
      {
        photoFinale && (
          <Picture
            src={photoFinale}
            alt=""
            formats={['avif', 'webp']}
            widths={largeursSrcset(photoFinale, { largeurs: [768, 1280, 1920] })}
            sizes="100vw"
            loading="eager"
            decoding="async"
          />
        )
      }
      <span class="film__voile film__voile--fort"></span>
    </div>
    <div class="film__compo film__compo--finale">
      <p class="film__titre film__titre--centre">
        <span class="film__masque"><span class="film__ligne" data-anime="titre-5a">Devenez</span></span>
        <span class="film__masque"><span class="film__ligne film__ligne--accent" data-anime="titre-5b">partenaire</span></span>
      </p>
      <span class="film__filet" data-anime="filet-5" aria-hidden="true"></span>
      <p class="film__actions">
        <Button
          variante="pleine"
          taille="grande"
          libelle="Discutons-en"
          href={`mailto:${EMAIL}`}
          class="film__bouton"
          data-anime="bouton-1"
        />
        <Button
          variante="contour"
          taille="grande"
          libelle="Télécharger le dossier (PDF, 1,5 Mo)"
          href={PDF}
          telechargement
          class="film__bouton"
          data-anime="bouton-2"
        />
      </p>
      <div class="film__coda" data-anime="coda">
        <span class="film__invite-trait" data-anime="invite-trait" aria-hidden="true"></span>
        <p class="film__invite">Faites défiler pour découvrir la page</p>
        <button type="button" class="film__revoir" data-revoir>Revoir</button>
      </div>
    </div>
  </div>

  {/* ── Progression : cinq segments fins, un par scène ────────────────── */}
  <div class="film__progression" aria-hidden="true">
    <span class="film__segment"><span class="film__segment-rempli" data-segment="1"></span></span>
    <span class="film__segment"><span class="film__segment-rempli" data-segment="2"></span></span>
    <span class="film__segment"><span class="film__segment-rempli" data-segment="3"></span></span>
    <span class="film__segment"><span class="film__segment-rempli" data-segment="4"></span></span>
    <span class="film__segment"><span class="film__segment-rempli" data-segment="5"></span></span>
  </div>
</div>

<script is:inline>
  // Filet de sécurité, volontairement bête : si le module d'animation ne
  // démarre jamais (fichier non chargé, erreur d'exécution), la couche du
  // film resterait un écran d'encre posé sur la page. Ces trois gestes la
  // retirent alors sans lui. Dès que le module a démarré (data-pret), ils ne
  // font plus rien : c'est lui qui gère la fermeture, en fondu.
  (function () {
    var film = document.querySelector('[data-film-ouverture]');
    if (!film) return;
    var retirer = function () {
      if (!film.dataset.pret && film.isConnected) film.remove();
    };
    var passer = film.querySelector('[data-passer]');
    if (passer) passer.addEventListener('click', retirer);
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') retirer();
    });
    window.addEventListener('scroll', retirer, { passive: true });
  })();
</script>

<script>
  // ── Le chef d'orchestre du film ──────────────────────────────────────────
  // Tout passe par la Web Animations API : chaque élément reçoit sa propre
  // animation (délai absolu sur une même origine), une animation « maître »
  // sert d'horloge pour ce qui ne s'anime pas tout seul (fenêtres de
  // visibilité des scènes, compteurs), et la liste complète se met en pause
  // d'un bloc quand l'onglet est masqué.

  const film = document.querySelector<HTMLElement>('[data-film-ouverture]');
  const mediaReduit = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (film && (mediaReduit.matches || !('animate' in Element.prototype))) {
    // Mouvement réduit (ou navigateur sans WAAPI, où le film serait figé) :
    // pas de film du tout. La CSS le masque déjà ; on retire la couche et on
    // libère la page tout de suite.
    film.remove();
    window.dispatchEvent(new Event('film-ouverture:fin'));
  } else if (film) {
    demarrer(film);
  }

  function demarrer(couche: HTMLElement) {
    // Le module est vivant : le filet de sécurité inline s'efface.
    couche.dataset.pret = '1';

    const DUREE_TOTALE = 15400;
    const E1 = 'cubic-bezier(0.22, 0.61, 0.36, 1)'; // la courbe de sortie maison
    const E2 = 'cubic-bezier(0.32, 0, 0.24, 1)'; // celle des balayages métalliques

    // ── Dessins de mouvement partagés ──
    // 135 % : assez pour que la ligne soit entièrement sous la fenêtre du
    // masque avant de monter (la fenêtre déborde de 0,3 em sous l'élément).
    const LEVER: Keyframe[] = [{ transform: 'translateY(135%)' }, { transform: 'translateY(0%)' }];
    const POSER: Keyframe[] = [
      { opacity: 0, transform: 'translateY(18px)' },
      { opacity: 1, transform: 'translateY(0)' },
    ];
    // L'interlettrage qui se resserre : un scaleX qui se pose, jamais de
    // letter-spacing animé.
    const POSER_SERRER: Keyframe[] = [
      { opacity: 0, transform: 'translateY(0.9em) scaleX(1.08)' },
      { opacity: 1, transform: 'translateY(0) scaleX(1)' },
    ];
    const MOT_POSER: Keyframe[] = [
      { opacity: 0, transform: 'translateY(135%) scale(1.05)' },
      { opacity: 1, transform: 'translateY(0) scale(1)' },
    ];
    const TRACER: Keyframe[] = [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }];
    const PIVOTER: Keyframe[] = [
      { opacity: 0, transform: 'rotate(-90deg) scale(0.4)' },
      { opacity: 1, transform: 'rotate(0deg) scale(1)' },
    ];
    const FONDU: Keyframe[] = [{ opacity: 0 }, { opacity: 1 }];
    // La respiration du trait d'invite : UNE inspiration, puis le repos
    // (l'état de départ et d'arrivée est celui de la CSS). Finie, jamais en
    // boucle : la fin du film reste figée au pixel près.
    const RESPIRER: Keyframe[] = [
      { opacity: 0.45, transform: 'scaleY(0.6)' },
      { opacity: 1, transform: 'scaleY(1)', offset: 0.5 },
      { opacity: 0.45, transform: 'scaleY(0.6)' },
    ];
    const ZOOM_POSER: Keyframe[] = [{ transform: 'scale(1.07)' }, { transform: 'scale(1)' }];
    const SORTIE_SCENE: Keyframe[] = [
      { opacity: 1, transform: 'translateY(0)' },
      { opacity: 0, transform: 'translateY(-14px)' },
    ];
    // La fenêtre de lumière qui traverse le mot : seule la découpe bouge
    // (et l'opacité aux extrémités), le texte et son dégradé restent posés.
    const BALAYAGE: Keyframe[] = [
      { clipPath: 'inset(0% 76% 0% -8%)', opacity: 0 },
      { opacity: 0.9, offset: 0.2 },
      { opacity: 0.9, offset: 0.8 },
      { clipPath: 'inset(0% -8% 0% 76%)', opacity: 0 },
    ];
    const OUVRIR_HAUTEUR: Keyframe[] = [
      { clipPath: 'inset(50% 0% 50% 0%)' },
      { clipPath: 'inset(0% 0% 0% 0%)' },
    ];
    const OUVRIR_COTE: Keyframe[] = [
      { clipPath: 'inset(0% 100% 0% 0%)' },
      { clipPath: 'inset(0% 0% 0% 0%)' },
    ];
    const OUVRIR_BAS: Keyframe[] = [
      { clipPath: 'inset(0% 0% 100% 0%)' },
      { clipPath: 'inset(0% 0% 0% 0%)' },
    ];

    // ── La partition : un élément, un délai absolu, une durée ──
    interface Spec {
      sel: string;
      delai: number;
      duree: number;
      images: Keyframe[];
      easing?: string;
    }

    const SPECS: Spec[] = [
      // Scène 1 — base 0 : le logotype se lève, le filet se trace, la
      // sur-ligne se pose en se resserrant, puis la lame prend la lumière.
      { sel: '[data-anime="logo-1"]', delai: 200, duree: 800, images: LEVER },
      { sel: '[data-anime="logo-2"]', delai: 360, duree: 800, images: LEVER },
      { sel: '[data-anime="filet-1"]', delai: 900, duree: 700, images: TRACER },
      { sel: '[data-anime="surligne"]', delai: 1050, duree: 700, images: POSER_SERRER },
      { sel: '[data-anime="balayage-acier"]', delai: 1600, duree: 1100, images: BALAYAGE, easing: E2 },
      { sel: '[data-scene="1"]', delai: 2750, duree: 600, images: SORTIE_SCENE },

      // Scène 2 — base 3200 : la photo s'ouvre en hauteur et se pose en
      // zoom, le losange pivote, le titre monte, les compteurs grimpent.
      { sel: '[data-cadre="2"]', delai: 3200, duree: 900, images: OUVRIR_HAUTEUR },
      { sel: '[data-cadre="2"] img', delai: 3200, duree: 2600, images: ZOOM_POSER },
      { sel: '[data-anime="losange-2"]', delai: 3350, duree: 700, images: PIVOTER },
      { sel: '[data-anime="titre-2a"]', delai: 3480, duree: 760, images: LEVER },
      { sel: '[data-anime="titre-2b"]', delai: 3620, duree: 760, images: LEVER },
      { sel: '[data-anime="chiffre-60"]', delai: 4250, duree: 620, images: POSER },
      { sel: '[data-anime="chiffre-27"]', delai: 4400, duree: 620, images: POSER },
      { sel: '[data-scene="2"]', delai: 6050, duree: 600, images: SORTIE_SCENE },

      // Scène 3 — base 6400 : le podium s'ouvre de côté, le filet d'or se
      // trace, les deux lignes de palmarès montent, l'or prend la lumière.
      { sel: '[data-cadre="3"]', delai: 6400, duree: 900, images: OUVRIR_COTE },
      { sel: '[data-cadre="3"] img', delai: 6400, duree: 2600, images: ZOOM_POSER },
      { sel: '[data-anime="titre-3a"]', delai: 6680, duree: 760, images: LEVER },
      { sel: '[data-anime="titre-3b"]', delai: 6820, duree: 760, images: LEVER },
      { sel: '[data-anime="filet-3"]', delai: 7350, duree: 700, images: TRACER },
      { sel: '[data-anime="or-1"]', delai: 7550, duree: 650, images: POSER },
      { sel: '[data-anime="or-2"]', delai: 7850, duree: 650, images: POSER },
      { sel: '[data-anime="balayage-or"]', delai: 8300, duree: 1200, images: BALAYAGE, easing: E2 },
      { sel: '[data-scene="3"]', delai: 9450, duree: 600, images: SORTIE_SCENE },

      // Scène 4 — base 9800 : l'équipe se découvre par le haut, le titre
      // monte, les quatre mots-clés se posent en cascade.
      { sel: '[data-cadre="4"]', delai: 9800, duree: 900, images: OUVRIR_BAS },
      { sel: '[data-cadre="4"] img', delai: 9800, duree: 2600, images: ZOOM_POSER },
      // Le titre suit la photo de près et la cascade enchaîne : en desktop,
      // la colonne de texte ne laisse jamais sa moitié d'écran vide pendant
      // le fondu croisé 3→4.
      { sel: '[data-anime="titre-4a"]', delai: 9850, duree: 760, images: LEVER },
      { sel: '[data-anime="titre-4b"]', delai: 9990, duree: 760, images: LEVER },
      { sel: '[data-anime="mot-1"]', delai: 10700, duree: 640, images: MOT_POSER },
      { sel: '[data-anime="mot-2"]', delai: 10940, duree: 640, images: MOT_POSER },
      { sel: '[data-anime="mot-3"]', delai: 11180, duree: 640, images: MOT_POSER },
      { sel: '[data-anime="mot-4"]', delai: 11420, duree: 640, images: MOT_POSER },
      { sel: '[data-scene="4"]', delai: 12450, duree: 600, images: SORTIE_SCENE },

      // Scène 5 — base 12800 : la photo du hero en fondu sous voile fort,
      // le titre, le filet, les deux boutons, puis l'invite. Pas de sortie :
      // la scène reste posée jusqu'au geste du visiteur. Le fond et le titre
      // partent AVEC la sortie de la scène 4 (12450) : un vrai fondu croisé,
      // sans creux d'écran quasi vide autour de 13 s. Le trait d'invite
      // respire une seule fois (fini à 16350 ms : fin figée au pixel près).
      { sel: '[data-anime="fond-5"]', delai: 12450, duree: 1200, images: FONDU },
      { sel: '[data-anime="titre-5a"]', delai: 12800, duree: 800, images: LEVER },
      { sel: '[data-anime="titre-5b"]', delai: 12950, duree: 800, images: LEVER },
      { sel: '[data-anime="filet-5"]', delai: 13800, duree: 700, images: TRACER },
      { sel: '[data-anime="bouton-1"]', delai: 14050, duree: 620, images: POSER },
      { sel: '[data-anime="bouton-2"]', delai: 14200, duree: 620, images: POSER },
      { sel: '[data-anime="coda"]', delai: 14550, duree: 700, images: FONDU },
      { sel: '[data-anime="invite-trait"]', delai: 14550, duree: 1800, images: RESPIRER, easing: 'ease-in-out' },

      // Progression : chaque segment se remplit linéairement sur sa scène.
      { sel: '[data-segment="1"]', delai: 0, duree: 3200, images: TRACER, easing: 'linear' },
      { sel: '[data-segment="2"]', delai: 3200, duree: 3200, images: TRACER, easing: 'linear' },
      { sel: '[data-segment="3"]', delai: 6400, duree: 3400, images: TRACER, easing: 'linear' },
      { sel: '[data-segment="4"]', delai: 9800, duree: 3000, images: TRACER, easing: 'linear' },
      { sel: '[data-segment="5"]', delai: 12800, duree: 1800, images: TRACER, easing: 'linear' },
    ];

    // Fenêtres de visibilité des scènes (élargies de part et d'autre pour
    // couvrir les fondus croisés). Hors fenêtre, `visibility: hidden` : la
    // scène n'est ni peinte, ni focalisable, ni annoncée.
    const FENETRES: Array<[number, number]> = [
      [0, 3400],
      [3150, 6700],
      [6350, 10100],
      [9750, 13100],
      [12400, Number.POSITIVE_INFINITY],
    ];

    // Compteurs : montée 0 → valeur en 1,2 s (easeOutCubic), pilotée par
    // l'horloge maître — la pause de l'onglet les fige donc avec le reste.
    const COMPTEURS = Array.from(couche.querySelectorAll<HTMLElement>('[data-compte]')).map(
      (el, index) => ({
        el,
        fin: Number.parseInt(el.dataset.compte ?? '0', 10),
        debut: index === 0 ? 4350 : 4500,
        duree: 1200,
        courant: -1,
      }),
    );

    const scenes = Array.from(couche.querySelectorAll<HTMLElement>('[data-scene]'));

    let animations: Animation[] = [];
    let maitre: Animation | null = null;
    let enPause: Animation[] = [];
    let rafId = 0;
    let ferme = false;

    // ── La page sous le film est gelée (inert) pendant la lecture ──
    // « Passer » devient ainsi le premier focalisable du document, et aucun
    // parcours clavier ou lecteur d'écran ne se perd derrière la couche.
    const geles: HTMLElement[] = [];
    const contenant = couche.parentElement;
    for (const el of Array.from(document.body.children)) {
      if (!(el instanceof HTMLElement) || el.tagName === 'SCRIPT' || el.contains(couche)) continue;
      el.inert = true;
      geles.push(el);
    }
    if (contenant) {
      for (const el of Array.from(contenant.children)) {
        if (!(el instanceof HTMLElement) || el === couche || el.tagName === 'SCRIPT') continue;
        el.inert = true;
        geles.push(el);
      }
    }
    const degeler = () => {
      for (const el of geles) el.inert = false;
      geles.length = 0;
    };

    // ── L'horloge : visibilité des scènes et compteurs ──
    const sortieCubique = (t: number) => 1 - Math.pow(1 - t, 3);

    const battre = () => {
      const t = maitre?.currentTime != null ? Number(maitre.currentTime) : 0;

      scenes.forEach((scene, i) => {
        const [debut, fin] = FENETRES[i] ?? [0, 0];
        scene.style.visibility = t >= debut && t < fin ? 'visible' : 'hidden';
      });

      for (const c of COMPTEURS) {
        const progression = Math.min(Math.max((t - c.debut) / c.duree, 0), 1);
        const valeur = Math.round(sortieCubique(progression) * c.fin);
        if (valeur !== c.courant) {
          c.courant = valeur;
          c.el.textContent = String(valeur);
        }
      }

      if (maitre?.playState === 'finished') {
        rafId = 0;
        return;
      }
      rafId = requestAnimationFrame(battre);
    };

    // ── (Re)jouer le film depuis le début ──
    const jouer = () => {
      for (const a of animations) a.cancel();
      animations = [];
      enPause = [];
      if (rafId) cancelAnimationFrame(rafId);

      maitre = couche.animate([{ opacity: 1 }, { opacity: 1 }], {
        duration: DUREE_TOTALE,
        fill: 'forwards',
      });
      animations.push(maitre);

      for (const spec of SPECS) {
        const el = couche.querySelector<HTMLElement>(spec.sel);
        if (!el) continue;
        animations.push(
          el.animate(spec.images, {
            delay: spec.delai,
            duration: spec.duree,
            easing: spec.easing ?? E1,
            fill: 'both',
          }),
        );
      }

      for (const c of COMPTEURS) c.courant = -1;
      battre();
    };

    // ── Fermer : fondu court, puis la page reprend ses droits ──
    const fermer = (versTitre = false) => {
      if (ferme || !couche.isConnected) return;
      ferme = true;
      degeler();
      window.removeEventListener('scroll', surDefilement);
      window.removeEventListener('keydown', surClavier);
      document.removeEventListener('visibilitychange', surVisibilite);
      // La page peut lancer ses propres apparitions dès maintenant, pendant
      // que la couche s'efface.
      window.dispatchEvent(new Event('film-ouverture:fin'));
      couche.style.pointerEvents = 'none';
      const fondu = couche.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 420,
        easing: 'ease-out',
        fill: 'forwards',
      });
      fondu.onfinish = () => {
        if (rafId) cancelAnimationFrame(rafId);
        for (const a of animations) a.cancel();
        couche.remove();
        if (versTitre) {
          // Fermeture au clavier (Passer, Échap) : le focus se pose sur le
          // H1 du hero, là où la lecture reprend. Sans défilement : on y est.
          const titre = document.getElementById('sp-hero-titre');
          if (titre) {
            titre.setAttribute('tabindex', '-1');
            titre.focus({ preventScroll: true });
          }
        }
      };
    };

    // ── Les gestes ──
    // Défiler = passer. La position de départ est mémorisée : si le
    // navigateur restaure un défilement au chargement, ce n'est pas un geste.
    const y0 = window.scrollY;
    const surDefilement = () => {
      if (Math.abs(window.scrollY - y0) > 2) fermer();
    };
    const surClavier = (e: KeyboardEvent) => {
      if (e.key === 'Escape') fermer(true);
    };
    // Onglet masqué : tout en pause ; au retour, seules les animations que la
    // pause a suspendues repartent (rejouer une animation finie la relancerait).
    const surVisibilite = () => {
      if (!couche.isConnected) return;
      if (document.hidden) {
        enPause = animations.filter((a) => a.playState === 'running');
        for (const a of enPause) a.pause();
      } else {
        for (const a of enPause) if (a.playState === 'paused') a.play();
        enPause = [];
      }
    };

    window.addEventListener('scroll', surDefilement, { passive: true });
    window.addEventListener('keydown', surClavier);
    document.addEventListener('visibilitychange', surVisibilite);

    couche.querySelector('[data-passer]')?.addEventListener('click', () => fermer(true));
    couche.querySelector('[data-revoir]')?.addEventListener('click', () => jouer());

    // Film terminé : un clic sur le fond (hors liens et boutons) fait entrer
    // dans la page, en plus du défilement.
    couche.addEventListener('click', (e) => {
      if (maitre?.playState !== 'finished') return;
      if (e.target instanceof Element && e.target.closest('a, button')) return;
      fermer();
    });

    // Si la personne réduit les animations pendant la lecture, on coupe.
    mediaReduit.addEventListener('change', (e) => {
      if (e.matches) fermer();
    });

    jouer();
  }
</script>

<style>
  /*
   * La couche n'existe que si le JavaScript est passé ET que le mouvement
   * n'est pas réduit : dans tous les autres cas, `display: none` et la page
   * s'ouvre sur son hero. Le z-index passe au-dessus de tout le chrome du
   * site (nav 50, menu mobile 90, lien d'évitement 100).
   */
  .film {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 120;
    overflow: hidden;
    background: var(--ink);

    /* Rampes propres au film, interpolées 390 → 1440 comme les jetons. Le
       plafond du titre (64 px) garde chaque ligne entière dans sa colonne
       desktop : une ligne de masque qui se replie casserait la montée. */
    --film-titre-fs: clamp(36px, 25.6px + 2.6667vw, 64px);
    --film-nombre-fs: clamp(46px, 31.89px + 3.619vw, 84px);
    --film-motcle-fs: clamp(26px, 20.8px + 1.3333vw, 40px);
    --film-or-fs: clamp(15px, 13.14px + 0.4762vw, 20px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .film {
      display: grid;
    }
  }

  /* ═══ Les scènes : empilées sur la même cellule, une seule visible ══════ */

  .film__scene {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    visibility: hidden;
    overflow: hidden;
    padding: calc(env(safe-area-inset-top, 0px) + 76px) var(--gouttiere)
      calc(env(safe-area-inset-bottom, 0px) + 72px);
  }

  .film__compo {
    width: 100%;
    max-width: 1160px;
  }

  /* ── Révélations sous masque ──
     Le parent porte une fenêtre de clip fixe (les marges négatives absorbent
     ascendantes, descendantes et débord italique — au repos il ne rogne
     rien), l'enfant monte dessous en translateY. Même mécanique que le hero
     de la page. */
  /* ⚠️ Pas de `.film__masque > *` générique : avec le scopage Astro, il
     l'emporterait sur les display propres des enfants (flex du logotype…).
     Chaque coulisseau déclare le sien : .film__ligne, .film__logoligne,
     .film__motcle. */
  .film__masque {
    display: block;
    clip-path: inset(-0.4em -0.35em -0.3em);
  }

  .film__ligne {
    display: inline-block;
  }

  /* ═══ Scène 1 : le logotype ═════════════════════════════════════════════ */

  .film__compo--marque {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Le dessin du sur-titre de hero (parchemin adouci, interlettrage large). */
  .film__surligne {
    max-width: 30ch;
    margin: 0 0 clamp(20px, 17px + 0.76vw, 28px);
    font-family: var(--font-eyebrow);
    font-size: clamp(9.5px, 8.757px + 0.1905vw, 11.5px);
