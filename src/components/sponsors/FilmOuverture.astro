  }

  .film__filet--or {
    background: var(--or);
    margin-block-start: clamp(18px, 15px + 0.76vw, 24px);
  }

  /* ═══ Scènes à panneau photo (2, 3, 4) ══════════════════════════════════ */

  /*
   * Portrait d'abord : une vraie colonne — photo en panneau sur toute la
   * largeur, texte dessous, composition calée au centre de l'écran. Le
