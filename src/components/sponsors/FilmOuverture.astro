  .film__registre--or .film__nombre {
    color: var(--or);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    /* Un fond découpé sur le texte n'est peint que dans la boîte de
       l'élément : sans marge interne, ce qui dépasse de la ligne (la queue du
       3 elzévirien) n'aurait pas d'or du tout. La boîte s'étend donc
       jusqu'aux bords du masque. */
    .film__registre--or .film__nombre {
      padding: 0.1em 0.06em 0.14em;
      margin: -0.1em -0.06em -0.14em;
      background-image: linear-gradient(
        100deg,
        var(--or) 0%,
        var(--or) 36%,
        var(--or-clair) 46%,
        var(--or-eclat) 50%,
        var(--or-clair) 54%,
        var(--or) 64%,
        var(--or) 100%
      );
      background-repeat: no-repeat;
      background-size: 400% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  /* Les titres du film prennent la rampe du H1 de fiche arme (42 → 90) : six
