  @media (max-width: 819.98px) {
    .film__masque--bouton {
      flex: 1 1 100%;
    }

    .film__actions :global(.film__bouton) {
      display: flex;
      width: 100%;
      height: auto;
      min-height: 52px;
      padding-block: 14px;
