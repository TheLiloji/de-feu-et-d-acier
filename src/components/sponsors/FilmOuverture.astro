  }

  /* Le double de balayage : même texte posé au même endroit, en clair, dont
     seule la fenêtre de clip-path traverse (aucun dégradé animé). Invisible
     au repos. */
  .film__balayage {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
