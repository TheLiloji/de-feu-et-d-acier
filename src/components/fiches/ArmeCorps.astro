---
/**
 * Corps de la fiche arme — la « Description longue » du catalogue.
 *
 * La maquette (design-spec §5) ne montre qu'un paragraphe d'accroche, porté par
 * le hero. Le modèle de contenu, lui, prévoit un corps par arme
 * (`content-model.md`, champ « Description longue (fiche arme) ») : c'est ce
 * bloc. Il n'est plus qu'une **enveloppe de page** — la section, sa gouttière et
 * son rythme vertical ; tout le rendu appartient à `CorpsLibre`.
 *
 * Ce composant portait jusqu'ici son propre parcours d'arbre Markdoc, écrit
 * quand le dépôt n'avait pas de rendu partagé. Il en existait trois, presque
 * identiques et pas tout à fait d'accord (celui-ci ne passait pas les images par
 * `astro:assets`). Le champ accepte désormais des widgets insérés au fil du
 * texte (widgets.md §0) : les faire rendre par un quatrième parcours maison
 * n'avait plus de sens, et `Markdoc.transform` supprime en silence les tags
 * qu'il ne connaît pas. Le parcours est donc supprimé au profit de
 * `src/components/corps/CorpsLibre.astro`.
 *
 * Bloc **masqué** quand la description est vide.
 */
import CorpsLibre from '../corps/CorpsLibre.astro';
import type { EcoleConfig } from '../../config/ecoles';
import { decouperCorps } from '../../lib/corps';
import type { ContexteRaccourcis } from '../../lib/raccourcis';
import type { CibleRenvoi } from '../../lib/renvois';

export interface Props {
  /** Nœud Markdoc renvoyé par le lecteur : `(await entree.description()).node`. */
  node?: unknown;
  /** École servie par la page — résout les adresses du widget « Bouton ». */
  ecole: EcoleConfig;
  /**
   * Contexte des raccourcis `{tarif}`, `{creneaux}`, `{arme}`… de la page.
   * Sans lui, la description longue serait le seul champ de texte riche du site
   * où « {tarif} » s'afficherait littéralement (ARCHITECTURE.md §7).
   */
  ctx: ContexteRaccourcis;
  /** Chemin du fichier, cité dans tous les messages d'erreur du corps. */
  source?: string;
  /** Index des cibles de renvoi, bâti par la page (`indexRenvois(...)`). */
  renvois: readonly CibleRenvoi[];
  class?: string;
}

const {
  node,
  ecole,
  ctx,
  source = 'la description longue d’une arme',
  renvois,
  class: classe,
} = Astro.props;

/*
 * Le découpage est pur et sans effet de bord : le refaire ici ne coûte qu'un
 * parcours d'arbre, et c'est la seule façon de savoir si la section a quelque
 * chose à montrer — un corps fait d'un seul widget n'a pas de prose, un corps
 * vide n'a rien du tout, et une section vide laisserait voir ses marges.
 */
const aDuContenu = decouperCorps(node, source).length > 0;
---

{
  aDuContenu && (
    <section class:list={['corps-arme', classe]}>
      <div class="gouttiere">
        <CorpsLibre node={node} ecole={ecole} ctx={ctx} source={source} renvois={renvois} />
      </div>
    </section>
  )
}

<style>
  .corps-arme {
    padding-block: clamp(22px, 15.3px + 1.714vw, 40px) clamp(36px, 13.714px + 5.714vw, 96px);
  }
</style>
