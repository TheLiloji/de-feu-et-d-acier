---
/**
 * Hero de la fiche prof — design-spec §6.1/§6.3 (desktop) et §6.2/§6.4 (mobile).
 *
 * Deux compositions très différentes, **un seul balisage** : la grille place le
 * bloc de titre à côté du portrait au-dessus de 1000 px, et par-dessus lui en
 * dessous — la maquette mobile incruste en effet le nom sur la photo, avec
 * voile, assise et pastille de retour. Un seul `<Picture>` est donc rendu,
 * quelle que soit la largeur : pas de photo chargée deux fois, pas de lien
 * dupliqué au clavier.
 *
 * **1000 px et non 820** : la colonne portrait de 500 px de la maquette ne
 * laissait que 207 px au texte à 820 px — nom sur deux lignes, accroche cassée,
 * bio à 26 signes par ligne. Même seuil que la nav (`Nav.astro`) et que la
 * fiche arme, pour que la page ne change pas de gabarit en deux temps.
 *
 *   desktop                        mobile
 *   ┌─────────┬──────────┐         ┌────────────────┐
 *   │ portrait│  titre   │         │ photo + titre  │  ← même cellule
 *   │  HEMA   ├──────────┤         ├────────────────┤
 *   │         │  corps   │         │     corps      │
 *   └─────────┴──────────┘         └────────────────┘
 *
 * Le bouton « PROFIL HEMA RATINGS » vit sous le portrait en desktop
 * (design-spec §6.3) ; en mobile la maquette le déplace dans la pile de CTA du
 * bas (§6.4), rendue par `ProfCta`. C'est le seul élément dupliqué de la page :
 * un bouton sans image, dont la copie inutile est retirée par `display: none`
 * — donc absente de l'arbre d'accessibilité et de la tabulation.
 *
 * Le bloc vidéo est masquable : sans lien ni vignette, `VideoCard` ne rend
 * rien (ARCHITECTURE.md §1) — et la classe `--sans-video` recompose alors le
 * hero desktop, que la maquette n'avait dessiné qu'avec sa vignette d'interview.
 * Son `sizes` (`720px`) n'est pas la bascule du gabarit mais la largeur de
 * fenêtre à partir de laquelle la colonne dépasse les 640 px de la vignette,
 * en une comme en deux colonnes.
 *
 * **La biographie a quitté le hero** (widgets.md §7.14). Elle est devenue un
 * corps libre : le rédacteur y insère des galeries, des vidéos, des renvois vers
 * d'autres pages. Un corps qui porte tout cela n'a plus sa place dans une
 * colonne de hero — il est rendu par la page, sous ce bloc. Ne restent ici que
 * le portrait, l'identité, la vidéo de la fiche et le crédit du portrait.
 */
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';
import VideoCard from '../ui/VideoCard.astro';
import { largeursSrcset } from '../../lib/images';

export interface LienExterneProf {
  libelle?: string | null;
  url?: string | null;
}

export interface VideoProf {
  /** Titre affiché sur la carte : interview, combat, highlight… (CMS). */
  titre?: string | null;
  url?: string | null;
  duree?: string | null;
  vignette?: ImageMetadata | null;
  /** Piste `.vtt` française, servie à côté de la vidéo (WCAG 1.2.2). */
  sousTitres?: string | null;
  /** Image d'attente du lecteur, si ce n'est pas la vignette. */
  affiche?: string | null;
}

export interface Props {
  /** Nom complet — le `<h1>` de la page. */
  nom: string;
  /** Ligne d'armes déjà composée. Ex. « Épée longue ». */
  armes?: string;
  /** Accroche d'une ligne. */
  accroche?: string;
  /**
   * « Accroche dorée (palmarès) » du CMS.
   *
   * Passe l'accroche en lettres d'or (dégradé métallique balayé une fois) et
   * dore les trois ornements du hero : le tiret de l'accroche, le filet, la
   * ligne d'armes. Rien d'autre ne change — et sur une fiche décochée, pas une
   * règle de ce fichier ne s'applique.
   */
  doree?: boolean;
  portrait?: ImageMetadata | null;
  portraitAlt?: string;
  /** `object-position` issu du cadrage CMS (`cadrageCss()`). */
  portraitPosition?: string;
  /** Crédit photo saisi dans le CMS. Masqué si vide. */
  credit?: string;
  /** Lien externe du CMS — profil HEMA Ratings, site personnel. */
  lienExterne?: LienExterneProf | null;
  /** Cible de la pastille de retour mobile. */
  retour: string;
  /** Nom accessible de la pastille de retour. */
  libelleRetour?: string;
  /** Pastille posée en haut à droite de la photo, en mobile. */
  tag?: string;
  video?: VideoProf | null;
  /** Légende sous la vignette vidéo. */
  legendeVideo?: string;
  /** `id` du `<h1>`, pour l'`aria-labelledby` de la page. */
  idTitre?: string;
  class?: string;
}

const {
  nom,
  armes,
  accroche,
  doree = false,
  portrait = null,
  portraitAlt,
  portraitPosition = '50% 20%',
  credit,
  lienExterne = null,
  retour,
  libelleRetour = 'Retour aux encadrants',
  tag = 'Fiche prof',
  video = null,
  // Défaut neutre : toutes les vidéos de prof ne sont pas des interviews
  // (celle de Gabriel est un highlight de combat). Le CMS peut préciser.
  legendeVideo = 'En vidéo',
  idTitre = 'fiche-prof-titre',
  class: classe,
} = Astro.props;

const alt = portraitAlt || `Portrait de ${nom}`;
const aLienExterne = Boolean(lienExterne?.url);
const libelleLienExterne = lienExterne?.libelle?.trim() || 'Profil HEMA Ratings';
const aVideo = Boolean(video?.url || video?.vignette);
/*
 * Le filet ne se pose que s'il sépare deux choses. Depuis que la biographie est
 * sortie du hero, une fiche sans vidéo ni crédit de portrait n'a plus rien sous
 * l'accroche : le filet y flotterait seul au milieu de la colonne.
 *
 * Une accroche dorée fait exception, et c'est la seule : le filet n'y sépare
 * plus, il **ferme** — c'est l'ornement d'or que le client a demandé sous la
 * ligne de palmarès. Une fiche décochée retrouve exactement la règle d'avant.
 */
const aDuCorps = aVideo || Boolean(credit) || doree;
---

<div
  class:list={['prof-hero', { 'prof-hero--sans-video': !aVideo }, classe]}
  style={`--prof-hero-position:${portraitPosition}`}
>
  <div class="prof-hero__media">
    <div class="prof-hero__cadre">
      {
        portrait ? (
          <Picture
            src={portrait}
            alt={alt}
            formats={['avif', 'webp']}
            widths={largeursSrcset(portrait, { largeurs: [390, 500, 780, 1000] })}
            sizes="(min-width: 1000px) 35vw, 100vw"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span class="prof-hero__vide" aria-hidden="true" />
        )
      }

      <span class="prof-hero__voile" aria-hidden="true"></span>
      <span class="prof-hero__assise" aria-hidden="true"></span>

      <div class="prof-hero__barre">
        <Pill variante="ronde" icone="arrow-left" cote={36} href={retour} titre={libelleRetour} />
        <Pill variante="tag" libelle={tag} />
      </div>
    </div>

    {
      aLienExterne && (
        <div class:list={['prof-hero__hema', { 'prof-hero__hema--or': doree }]}>
          <Button
            variante="contour"
            libelle={libelleLienExterne}
            href={lienExterne!.url!}
            externe
          />
        </div>
      )
    }
  </div>

  <div class="prof-hero__titre">
    {armes && <p class:list={['prof-hero__armes', { 'prof-hero__armes--or': doree }]}>{armes}</p>}
    <h1 class="prof-hero__nom" id={idTitre}>{nom}</h1>
    {
      accroche && (
        <p class:list={['prof-hero__accroche', { 'prof-hero__accroche--or': doree }]}>{accroche}</p>
      )
    }
  </div>

  <div class="prof-hero__corps">
    {
      aDuCorps && (
        <span class:list={['prof-hero__filet', { 'prof-hero__filet--or': doree }]} aria-hidden="true" />
      )
    }

    {
      aVideo && (
        <div class="prof-hero__video">
          <VideoCard
            url={video?.url}
            image={video?.vignette ?? null}
            alt=""
            sousTitres={video?.sousTitres}
            affiche={video?.affiche}
            duree={video?.duree}
            titre={video?.titre?.trim() || legendeVideo}
            taille="l"
            ratio="16 / 9"
            rayon={3}
            sizes="(min-width: 720px) 640px, 92vw"
          />
        </div>
      )
    }

    {credit && <p class="prof-hero__credit">{credit}</p>}
  </div>
</div>

<style>
  /* ── Grille ─────────────────────────────────────────────────────────────── */

  .prof-hero {
    display: grid;
    width: 100%;
    max-width: var(--largeur-max);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'media'
      'corps';
    row-gap: clamp(24px, 1rem + 2vw, 30px);
  }

  .prof-hero__media {
    grid-area: media;
  }

  /* Mobile : le titre est incrusté en bas de la photo (design-spec §6.4). */
  .prof-hero__titre {
    position: relative;
    z-index: 1;
    grid-area: media;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 var(--gouttiere) clamp(28px, 6vw, 46px);
  }

  .prof-hero__corps {
    grid-area: corps;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 0.6rem + 1.6vw, 26px);
    padding-inline: var(--gouttiere);
  }

  /* ── La photo et ses couches ────────────────────────────────────────────── */

  .prof-hero__cadre {
    position: relative;
    overflow: hidden;
    /* 390 × 440 dans la maquette (112,8 vw) ; au-delà, le cadre se plafonne
       plutôt que de devenir un portrait d'un mètre de haut sur les tablettes —
       même parti que le hero de fiche arme, qui plafonne à 500 px. */
    height: min(112.8vw, 560px);
    background: var(--char);
  }

  .prof-hero__cadre :global(picture),
  .prof-hero__cadre :global(img) {
    width: 100%;
    height: 100%;
  }

  .prof-hero__cadre :global(img) {
    object-fit: cover;
    object-position: var(--prof-hero-position, 50% 20%);
  }

  .prof-hero__vide {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--char);
  }

  /* Voile uniforme le plus léger du site (35 %) : le nom doit se lire, le
     visage rester net. */
  .prof-hero__voile {
    position: absolute;
    inset: 0;
    background: var(--veil-ink-35);
  }

  /* « Assise » de la maquette : un aplat de 200 px ancré en bas. On la rend en
     dégradé, comme `MediaCard`, pour éviter l'arête franche en travers de la
     photo (design-spec §9.8, recommandation d'intégration). */
  .prof-hero__assise {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 58%;
    background: linear-gradient(to top, var(--veil-ink-85), var(--veil-ink-45) 62%, transparent);
  }

  .prof-hero__barre {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
  }

  /* ── Le titre ───────────────────────────────────────────────────────────── */

  .prof-hero__armes {
    font-family: var(--font-eyebrow);
    font-size: clamp(9.5px, 8.943px + 0.1429vw, 11px);
    font-weight: 600;
    line-height: var(--lh-body-tight);
    letter-spacing: 0.24em; /* 2.2 px en mobile, 3.2 px en desktop */
    text-transform: uppercase;
    color: var(--ember);
  }

  /* L'or prend la place de l'ember sur la ligne d'armes, il ne s'y ajoute pas :
     deux accents côte à côte, c'est déjà un de trop. */
  .prof-hero__armes--or {
    color: var(--or);
  }

  .prof-hero__nom {
    /* 36 px à 390, 80 px à 1440 — la fiche arme monte à 90, le prof s'arrête
       à 80 (design-spec §6.1). */
    font-size: clamp(36px, 19.657px + 4.1905vw, 80px);
    font-weight: 400;
    line-height: var(--lh-display);
    text-wrap: balance;
    color: var(--parch);
  }

  .prof-hero__accroche {
    max-width: 46ch;
    font-size: clamp(12.5px, 10.829px + 0.4286vw, 17px);
    font-weight: 500;
    line-height: var(--lh-body-tight);
    color: var(--parch-soft);
  }

  /* ── L'accroche dorée ───────────────────────────────────────────────────── */

  /*
   * Trois couches, de la plus robuste à la plus ornementale — chacune est le
   * repli de la suivante :
   *
   *   1. `color: var(--or)` — l'or plein. C'est ce que voit un navigateur sans
   *      `background-clip: text` (10,39:1 sur $ink, cf. tokens.css) ;
   *   2. le dégradé métallique en `background-clip: text` ;
   *   3. le balayage : UNE passe de gauche à droite au chargement, rejouée au
   *      survol du bloc de titre. Jamais de boucle.
   *
   * Le dégradé fait 4 × la largeur du bloc et sa bande claire occupe le quart
   * central : la fenêtre visible (25 % de l'image) est donc **entièrement en
   * `--or`** aux positions 100 % (départ) comme 0 % (arrivée), et ne montre le
   * reflet qu'entre les deux. Le reflet entre par la gauche, traverse toute la
   * ligne et sort par la droite ; au repos, l'accroche est un or plein et
   * uniforme — le plus lisible des états (10,39:1 partout), et le plus sobre.
   *
   * **Les deux extrémités du balayage sont la même image**, et ce n'est pas un
   * détail de goût : le survol relance l'animation en changeant son nom, et
   * quitter le survol la relance une seconde fois, puisque le nom revient à sa
   * valeur d'origine. Avec un repos à mi-parcours, ce retour ferait disparaître
   * le reflet d'un coup pendant le délai avant de le refaire passer — un
   * clignotement à chaque fois que la souris s'éloigne du nom (mesuré au
   * banc : 480 ms d'or plat). Départ et arrivée identiques, ce retour ne se
   * voit plus : il ne reste qu'une passe de plus, sans le moindre saut.
   *
   * ⚠️ Deux classes dans le sélecteur, et ce n'est pas du zèle. Plus bas dans ce
   * fichier, `@media (min-width: 1000px) { .prof-hero__accroche { color:
   * var(--parch) } }` (design-spec §6.3) a exactement la même spécificité et
   * vient après : avec une seule classe, elle reprenait la main sur l'or à
   * partir de 1000 px. Mesuré au banc avant correction : `getComputedStyle`
   * rendait `rgb(236, 232, 222)` à 1440 px, soit du parchemin — invisible tant
   * que `background-clip: text` peint les glyphes, mais c'était exactement la
   * couleur de repli, et un navigateur sans `background-clip: text` n'aurait vu
   * aucun palmarès en desktop. Toutes les règles de ce bloc qui se disputent une
   * propriété avec `.prof-hero__accroche` portent donc la double classe.
   */
  .prof-hero__accroche.prof-hero__accroche--or {
    color: var(--or);
    font-weight: 600;
  }

  /* Le tiret de palmarès. Un filet, pas un caractère : rien à faire prononcer à
     un lecteur d'écran, et il ne dépend pas de la police. */
  .prof-hero__accroche--or::before {
    content: '';
    display: inline-block;
    width: clamp(15px, 1.4vw, 22px);
    height: 1px;
    margin-inline-end: 10px;
    vertical-align: middle;
    background: var(--or);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .prof-hero__accroche.prof-hero__accroche--or {
      /* Le fond est peint sur la boîte, pas sur les glyphes : sans
         `fit-content`, la moitié du dégradé tomberait dans le blanc à droite
         de cette ligne courte, et le reflet ne traverserait jamais le texte. */
      width: fit-content;
      background-image: linear-gradient(
        100deg,
        var(--or) 0%,
        var(--or) 38%,
        var(--or-clair) 50%,
        var(--or) 62%,
        var(--or) 100%
      );
      background-repeat: no-repeat;
      background-size: 400% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      animation: prof-or-balayage 1500ms cubic-bezier(0.32, 0, 0.24, 1) 480ms 1 forwards;
    }

    /* Rejouée au survol : changer de nom d'animation la relance depuis le
       début, sans une ligne de JavaScript. */
    .prof-hero__titre:hover .prof-hero__accroche--or {
      animation-name: prof-or-balayage-bis;
      animation-delay: 0ms;
    }
  }

  /* Deux noms, un seul dessin : le second n'existe que pour donner au survol un
     nom d'animation différent, seul moyen en CSS pur de rejouer une passe. */
  @keyframes prof-or-balayage {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  @keyframes prof-or-balayage-bis {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  /*
   * Moins d'animations : plus de balayage du tout, et le dégradé se fige sur sa
   * position centrale — le reflet est posé au milieu de la ligne, immobile. Ce
   * n'est pas la même image que le repos animé (or plein) et c'est voulu : sans
   * balayage, un or uniforme perdrait le métal que la case promet. Le client
   * demandait un dégradé statique, en voici un.
   *
   * La règle globale de global.css écrase les durées avec `!important` : il en
   * faut donc un ici pour couper l'animation plutôt que de la jouer en 0,01 ms.
   */
  @media (prefers-reduced-motion: reduce) {
    /* Double classe ici aussi : la règle du `@supports` ci-dessus la porte, et
       sans elle ce `background-position` perdrait la comparaison — le dégradé
       se figerait sur la position de départ (or plat) au lieu du reflet centré. */
    .prof-hero__accroche.prof-hero__accroche--or,
    .prof-hero__titre:hover .prof-hero__accroche--or {
      animation: none !important;
      background-position: 50% 0;
    }
  }

  /* ── Le corps ───────────────────────────────────────────────────────────── */

  /* Le filet de 56 px sous l'accroche n'existe qu'en desktop : en mobile, ce
     qui le suit est déjà détaché par le changement de fond. */
  .prof-hero__filet {
    display: none;
    width: 56px;
    height: 1px;
    background: var(--parch-line);
  }

  /* Un filet d'or plein ferait barre de séparation ; il s'éteint donc vers la
     droite, comme le trait sous un nom gravé. */
  .prof-hero__filet--or {
    width: 72px;
    background: linear-gradient(90deg, var(--or) 0%, var(--or) 34%, transparent 100%);
  }

  .prof-hero__video {
    max-width: 640px;
    margin-block-start: clamp(10px, 0.4rem + 1vw, 22px);
  }

  .prof-hero__credit {
    font-size: var(--fs-body-xxs);
    line-height: var(--lh-body-tight);
    color: var(--parch-mute);
  }

  /* ── ≥ 820 px : le fil d'Ariane prend le relais de la pastille de retour ── */

  /* `ProfFilAriane` s'affiche dès 820 px : garder en plus la barre incrustée
     (pastille « retour » + tag « FICHE PROF ») ferait deux chemins de retour
     l'un sur l'autre. Le gabarit du hero, lui, reste mobile jusqu'à 1000 px. */
  @media (min-width: 820px) {
    .prof-hero__barre {
      display: none;
    }
  }

  /* ── Desktop : deux colonnes, plus d'incrustation ───────────────────────── */

  @media (min-width: 1000px) {
    /* La colonne portrait n'atteint les 500 px de la maquette qu'à 1440 : elle
       part de 340 px à la bascule, sinon la colonne de texte repartait à 400 px
       à peine. Rampe 1000 → 1440, comme la gouttière du bloc. */
    .prof-hero {
      grid-template-columns: minmax(0, clamp(340px, -23.636px + 36.3636vw, 500px)) minmax(0, 1fr);
      grid-template-areas:
        'media titre'
        'media corps';
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: clamp(40px, -96.364px + 13.6364vw, 100px);
      row-gap: clamp(12px, 0.4rem + 0.9vw, 16px);
      padding-inline: var(--gouttiere);
    }

    /*
     * État « fiche sans vidéo » (les trois fiches d'aujourd'hui) : la hauteur du
     * hero vient du portrait 5/6, que rien ne compense à droite — la colonne de
     * texte s'arrêtait 390 px avant le bas, et la page se lisait comme une
     * composition inachevée. Deux rangées `1fr` de part et d'autre recentrent le
     * couple titre + corps face au portrait. Dès qu'une vidéo d'interview est
     * saisie, la maquette reprend ses droits : les rangées vides se referment et
     * les deux colonnes repartent du haut.
     */
    .prof-hero--sans-video {
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        'media .'
        'media titre'
        'media corps'
        'media .';
    }

    .prof-hero__media {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .prof-hero__titre {
      position: static;
      grid-area: titre;
      align-self: start;
      gap: 0;
      padding: 0;
    }

    .prof-hero__corps {
      padding-inline: 0;
      gap: clamp(18px, 0.6rem + 1.2vw, 26px);
    }

    .prof-hero__cadre {
      height: auto;
      aspect-ratio: 5 / 6; /* 500 × 600 */
      border-radius: var(--radius-2);
    }

    /* Ni voile, ni assise : le desktop n'incruste rien (la barre du haut est
       déjà retirée à 820 px, avec l'arrivée du fil d'Ariane). */
    .prof-hero__voile,
    .prof-hero__assise {
      display: none;
    }

    .prof-hero__armes {
      margin-block-end: 14px;
    }

    /* design-spec §6.3 : l'accroche est en `$parch` plein, la bio en
       `$parch-soft` — c'est ce contraste qui fait ressortir la ligne de punch
       du reste du texte. En mobile (§6.4), les deux restent en `$parch-soft`. */
    .prof-hero__accroche {
      color: var(--parch);
    }

    .prof-hero__nom {
      margin-block-end: 16px;
    }

    .prof-hero__filet {
      display: block;
      margin-block-start: 10px;
    }
  }

  /*
   * Le bouton du lien externe vit sous le portrait en desktop ; en mobile
   * `ProfCta` le rend en pleine largeur avec le bouton d'essai. Les deux copies
   * se relaient au seuil de bascule — jamais visibles ensemble, jamais absentes
   * toutes les deux.
   *
