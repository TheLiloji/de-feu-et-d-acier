---
/**
 * Bande d'appel de fin de fiche arme — design-spec §5.1 (bloc 5), §5.3, §5.4.
 *
 * Colonne centrée sous filet : « Envie de tester l'épée longue ? » en Cormorant,
 * la promesse en display italique, puis le bouton plein ember.
 *
 * Les trois textes viennent du CMS (`fiches.yaml`, rubrique « Bandeau de fin —
 * fiche arme ») : ils arrivent ici **déjà résolus**, `{arme}` et `{essai}`
 * remplacés par la page. Le composant ne lit rien.
 *
 * La maquette mobile ne garde que le bouton (§5.2, bloc 5) ; la parité de
 * contenu impose de conserver le titre et la promesse — le mobile les compacte
 * et passe le bouton en pleine largeur.
 */
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';

export interface Props {
  titre?: string | null;
  sousTitre?: string | null;
  libelle?: string | null;
  href: string;
  externe?: boolean;
  id?: string;
}

const { titre, sousTitre, libelle, href, externe = false, id } = Astro.props;

const texteBouton = libelle || 'Venir essayer';
const idTitre = id ? `${id}-titre` : undefined;
---

<section class="bande-cta" id={id} aria-labelledby={titre ? idTitre : undefined}>
  <div class="gouttiere bande-cta__contenu">
    {titre && <SectionTitle lignes={[{ texte: titre }]} taille="m" balise="h2" centre id={idTitre} />}
    {sousTitre && <p class="bande-cta__promesse">{sousTitre}</p>}
    <p class="bande-cta__action">
      <Button
        variante="pleine"
        taille="grande"
        libelle={texteBouton}
        href={href}
        externe={externe}
        class="bande-cta__bouton"
      />
    </p>
  </div>
</section>

<style>
  .bande-cta {
    border-top: var(--filet);
    padding-block: clamp(40px, 25.14px + 3.81vw, 80px) clamp(44px, 24.7px + 4.95vw, 96px);
  }

  .bande-cta__contenu {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bande-cta__promesse {
    margin-top: 10px;
    max-width: 44ch;
    font-family: var(--font-display);
    font-size: clamp(14px, 13.257px + 0.1905vw, 16px);
    font-style: italic;
    line-height: 1.3;
    color: var(--parch-soft);
  }

  .bande-cta__action {
    display: flex;
    width: 100%;
    justify-content: center;
    margin-top: clamp(22px, 19.771px + 0.5714vw, 28px);
  }

  /* Sur mobile la maquette passe le bouton en pleine largeur (§5.4, bloc CTA).
     `Button` porte la classe : son style scopé à lui ne connaît pas ce cas,
     d'où un `:global()` sous une racine, elle, scopée. */
  @media (max-width: 819.98px) {
    .bande-cta__action :global(.bande-cta__bouton) {
      display: flex;
      width: 100%;
      padding-inline: 12px;
    }
  }
</style>
